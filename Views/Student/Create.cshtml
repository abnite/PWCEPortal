@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ViewModel.Student.StudentViewModel

@{
    ViewBag.Title = "Create Student";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Create New Student</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-user-plus me-2"></i>Student Registration
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Personal Information Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <h5 class="border-bottom pb-2">
                            <i class="fas fa-user-circle me-2"></i>Personal Information
                        </h5>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <select class="form-select" asp-for="Title">
                                <option value="">Select</option>
                                <option value="Mr">Mr</option>
                                <option value="Mrs">Mrs</option>
                                <option value="Miss">Miss</option>
                                <option value="Dr">Dr</option>
                            </select>
                            <label asp-for="Title">Title</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-floating">
                            <input asp-for="Surname" class="form-control" placeholder="Enter surname" required />
                            <label asp-for="Surname">Surname</label>
                            <span asp-validation-for="Surname" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-floating">
                            <input asp-for="OtherNames" class="form-control" placeholder="Enter other names" required />
                            <label asp-for="OtherNames">Other Names</label>
                            <span asp-validation-for="OtherNames" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="ApplicationNumber" class="form-control" placeholder="Enter application number" required />
                            <label asp-for="ApplicationNumber">Application Number</label>
                            <span asp-validation-for="ApplicationNumber" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="StudentId" class="form-control" placeholder="Enter Student ID No " required />
                            <label asp-for="StudentId">Student ID No.</label>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="DateOfBirth" type="date" class="form-control" required />
                            <label asp-for="DateOfBirth">Date of Birth</label>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="Gender" class="form-select" required>
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <label asp-for="Gender">Sex</label>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Contact Information Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <h5 class="border-bottom pb-2">
                            <i class="fas fa-address-book me-2"></i>Contact Information
                        </h5>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" required />
                            <label asp-for="Email">Email Address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text">Official email address</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="PhoneNo" class="form-control" placeholder="Enter phone number" required />
                            <label asp-for="PhoneNo">Phone Number</label>
                            <span asp-validation-for="PhoneNo" class="text-danger small"></span>
                            <div class="form-text">Include country code if international</div>
                        </div>
                    </div>
                </div>

                <!-- Academic Information Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <h5 class="border-bottom pb-2">
                            <i class="fas fa-graduation-cap me-2"></i>Academic Information
                        </h5>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="CollegeProgramId" class="form-select" required>
                                <option value="">Select Program</option>
                                @foreach (var program in Model.CollegePrograms)
                                {
                                    <option value="@program.Value">@program.Text</option>
                                }
                            </select>
                            <label asp-for="CollegeProgramId">Program</label>
                            <span asp-validation-for="CollegeProgramId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="EnrolmentYear" class="form-control" placeholder="Enter enrolment year" required />
                            <label asp-for="EnrolmentYear">Enrolment Year</label>
                            <span asp-validation-for="EnrolmentYear" class="text-danger small"></span>
                            <div class="form-text">Year student first enrolled (e.g., 2023)</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" asp-for="EntryLevel" required>
                                <option value="">Select Entry Level</option>
                                <option value="100">100 (First Year)</option>
                                <option value="200">200 (Second Year)</option>
                                <option value="300">300 (Third Year)</option>
                                <option value="400">400 (Fourth Year)</option>
                            </select>
                            <label asp-for="EntryLevel">Entry Level</label>
                            <span asp-validation-for="EntryLevel" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" asp-for="CurrentLevel" required>
                                <option value="">Select Current Level</option>
                                <option value="100">100 (First Year)</option>
                                <option value="200">200 (Second Year)</option>
                                <option value="300">300 (Third Year)</option>
                                <option value="400">400 (Fourth Year)</option>
                            </select>
                            <label asp-for="CurrentLevel">Current Level</label>
                            <span asp-validation-for="CurrentLevel" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Certificate Upload Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <h5 class="border-bottom pb-2">
                            <i class="fas fa-file-pdf me-2"></i>Certificate Upload
                        </h5>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="CertificateFile" class="form-label">Upload Certificate (PDF only)</label>
                            <input asp-for="CertificateFile" type="file" class="form-control" accept=".pdf" />
                            <span asp-validation-for="CertificateFile" class="text-danger small"></span>
                            <div class="form-text">Maximum file size: 5MB</div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Create Student
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Client-side validation
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Set current year as default for enrolment year if empty
        document.addEventListener('DOMContentLoaded', function() {
            const enrolmentYearField = document.getElementById('EnrolmentYear');
            if (enrolmentYearField && !enrolmentYearField.value) {
                enrolmentYearField.value = new Date().getFullYear();
            }
        });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }

        .form-floating label {
            color: #6c757d;
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .breadcrumb {
            background-color: transparent;
            padding: 0;
            font-size: 0.9rem;
        }

        .was-validated .form-control:invalid,
        .was-validated .form-select:invalid {
            border-color: #dc3545;
        }

        .was-validated .form-control:valid,
        .was-validated .form-select:valid {
            border-color: #198754;
        }

        .section-header {
            color: #495057;
            font-weight: 500;
        }
    </style>
}