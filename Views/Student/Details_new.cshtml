@using PWCEPortal.Models.StudentInfo
@model PWCEPortal.Models.StudentInfo.Student
@{
    ViewBag.Title = "Student Profile";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Student Profile</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Student")">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">Profile</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div class="profile-image-placeholder bg-light rounded-circle d-flex align-items-center justify-content-center me-3"
                     style="width: 50px; height: 50px;">
                    <i class="fas fa-user text-secondary"></i>
                </div>
                <h3 class="mb-0">
                    @Model.Surname, @Model.OtherNames
                </h3>
            </div>
            <div>
                <button onclick="printDiv('Print')" class="btn btn-light me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
            </div>
        </div>

        <div class="card-body">
            <div id="Print">
                <!-- Student Summary Card -->
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-id-card me-2"></i>Student Summary
                        </h4>
                        <span class="custom-badge bg-primary">ID: @Model.ApplicationNumber</span>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-2 text-center mb-3 mb-md-0">
                                <div class="profile-image-placeholder bg-light rounded-circle d-flex align-items-center justify-content-center mx-auto"
                                     style="width: 120px; height: 120px;">
                                    <i class="fas fa-user fa-3x text-secondary"></i>
                                </div>
                            </div>
                            <div class="col-md-10">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-4">Full Name:</dt>
                                            <dd class="col-sm-8 fw-bold">@(Model.Title + " " + Model.Surname + " " + Model.OtherNames)</dd>

                                            <dt class="col-sm-4">Program:</dt>
                                            <dd class="col-sm-8">
                                                <span class="custom-badge bg-info">@(Model.CollegeProgram?.ProgramName ?? "N/A")</span>
                                            </dd>

                                            <dt class="col-sm-4">Level:</dt>
                                            <dd class="col-sm-8">
                                                <span class="custom-badge bg-success">Level @Model.CurrentLevel</span>
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row mb-0">
                                            <dt class="col-sm-4">Contact:</dt>
                                            <dd class="col-sm-8">
                                                <i class="fas fa-phone me-2"></i>@Model.PhoneNo
                                            </dd>

                                            <dt class="col-sm-4">Email:</dt>
                                            <dd class="col-sm-8">
                                                <i class="fas fa-envelope me-2"></i>@Model.Email
                                            </dd>

                                            <dt class="col-sm-4">Status:</dt>
                                            <dd class="col-sm-8">
                                                <span class="custom-badge bg-success">Active</span>
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Profile Sections -->
                <div class="row">
                    <!-- Left Column -->
                    <div class="col-lg-6">
                        <!-- Personal Information -->
                        <div class="card mb-4">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">
                                    <i class="fas fa-user-circle me-2"></i>Personal Information
                                </h4>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#personalInfoCollapse">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="card-body collapse show" id="personalInfoCollapse">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Date of Birth:</dt>
                                            <dd class="col-sm-8">@(Model.DateOfBirth.ToShortDateString() ?? "N/A")</dd>

                                            <dt class="col-sm-4">Gender:</dt>
                                            <dd class="col-sm-8">@Model.Gender</dd>

                                            <dt class="col-sm-4">Marital Status:</dt>
                                            <dd class="col-sm-8">@Model.MaritalStatus</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Religion:</dt>
                                            <dd class="col-sm-8">@Model.Religion</dd>

                                            <dt class="col-sm-4">Denomination:</dt>
                                            <dd class="col-sm-8">@Model.ReligiousDenom</dd>

                                            <dt class="col-sm-4">Disability:</dt>
                                            <dd class="col-sm-8">
                                                @if (Model.DisabilityStatus.HasValue)
                                                {
                                                    <span class="custom-badge @(Model.DisabilityStatus.Value ? "bg-warning" : "bg-secondary")">
                                                        @(Model.DisabilityStatus.Value ? "Yes" : "No")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>N/A</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <dl class="row">
                                            <dt class="col-sm-2">Address:</dt>
                                            <dd class="col-sm-10">
                                                <i class="fas fa-map-marker-alt me-2"></i>@Model.ContactAddress
                                            </dd>

                                            <dt class="col-sm-2">Languages:</dt>
                                            <dd class="col-sm-10">
                                                <i class="fas fa-language me-2"></i>@Model.GhanaianLanguagesSpoken
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Family Information -->
                        <div class="card mb-4">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">
                                    <i class="fas fa-users me-2"></i>Family Information
                                </h4>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#familyInfoCollapse">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="card-body collapse show" id="familyInfoCollapse">
                                @if (ViewBag.Parents != null && ((List<ParentGuardian>)ViewBag.Parents).Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                            <tr>
                                                <th>Name</th>
                                                <th>Relationship</th>
                                                <th>Contact</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var parent in (List<ParentGuardian>)ViewBag.Parents)
                                            {
                                                <tr>
                                                    <td>@parent.FullName</td>
                                                    <td>
                                                        <span class="custom-badge bg-info">@parent.Relationship</span>
                                                    </td>
                                                    <td>
                                                        <div><i class="fas fa-phone me-2"></i>@parent.Telephone</div>
                                                        <small class="text-muted"><i class="fas fa-envelope me-2"></i>@parent.Email</small>
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i> No parent/guardian information available
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-lg-6">
                        <!-- Academic Information -->
                        <div class="card mb-4">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">
                                    <i class="fas fa-graduation-cap me-2"></i>Academic Information
                                </h4>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#academicInfoCollapse">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="card-body collapse show" id="academicInfoCollapse">
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <h5><i class="fas fa-book me-2"></i>Current Program</h5>
                                        <dl class="row">
                                            <dt class="col-sm-4">Program:</dt>
                                            <dd class="col-sm-8">@(Model.CollegeProgram?.ProgramName ?? "N/A")</dd>

                                            <dt class="col-sm-4">Entry Level:</dt>
                                            <dd class="col-sm-8">@Model.LevelOfEntry</dd>

                                            <dt class="col-sm-4">Current Level:</dt>
                                            <dd class="col-sm-8">@Model.CurrentLevel</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <h5><i class="fas fa-calendar-alt me-2"></i>Academic Timeline</h5>
                                        <dl class="row">
                                            <dt class="col-sm-4">Enrollment Year:</dt>
                                            <dd class="col-sm-8">@Model.EnrolmentYear</dd>

                                            <dt class="col-sm-4">Expected Completion:</dt>
                                            <dd class="col-sm-8">@Model.ExpectedCompletionYear</dd>
                                        </dl>
                                    </div>
                                </div>

                                @if (ViewBag.EducationHistories != null && ((List<EducationHistory>)ViewBag.EducationHistories).Any())
                                {
                                    <h5 class="mb-3"><i class="fas fa-history me-2"></i>Education History</h5>
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                            <tr>
                                                <th>Institution</th>
                                                <th>Period</th>
                                                <th>Leadership</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var history in (List<EducationHistory>)ViewBag.EducationHistories)
                                            {
                                                <tr>
                                                    <td>@history.SchoolName</td>
                                                    <td>
                                                        @history.FromDate.ToShortDateString() -
                                                        @history.ToDate.ToShortDateString()
                                                    </td>
                                                    <td>@history.OfficeHeld</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i> No education history available
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Financial Information -->
                        <div class="card">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">
                                    <i class="fas fa-wallet me-2"></i>Financial Information
                                </h4>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#financialInfoCollapse">
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                            <div class="card-body collapse show" id="financialInfoCollapse">
                                @if (ViewBag.FinancialInfo != null && ((List<FinancialInfo>)ViewBag.FinancialInfo).Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                            <tr>
                                                <th>SSNIT Number</th>
                                                <th>EZwich Account</th>
                                                <th>Account Number</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var financialInfo in (List<FinancialInfo>)ViewBag.FinancialInfo)
                                            {
                                                <tr>
                                                    <td>@financialInfo.SSNITNumber</td>
                                                    <td>@financialInfo.EZwichAccountName</td>
                                                    <td>@financialInfo.EZwichAccountNumber</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-0">
                                        <i class="fas fa-info-circle me-2"></i> No financial information available
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printDiv(divId) {
            const printContents = document.getElementById(divId).innerHTML;
            const originalContents = document.body.innerHTML;

            document.body.innerHTML = `
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Student Profile - @Model.Surname, @Model.OtherNames</title>
                    <style>
                        body { font-family: Arial, sans-serif; font-size: 12px; }
                        .card { border: 1px solid #ddd; margin-bottom: 15px; break-inside: avoid; }
                        .card-header { background-color: #f8f9fa; padding: 8px; font-weight: bold; }
                        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 11px; }
                        th, td { border: 1px solid #ddd; padding: 6px; text-align: left; }
                        th { background-color: #f8f9fa; }
                        .badge { padding: 2px 5px; border-radius: 3px; font-size: 11px; }
                        .bg-primary { background-color: #007bff!important; color: white; }
                        .bg-info { background-color: #17a2b8!important; color: white; }
                        .bg-success { background-color: #28a745!important; color: white; }
                        .bg-warning { background-color: #ffc107!important; color: #212529; }
                        .alert { padding: 8px; margin-bottom: 10px; border: 1px solid transparent; font-size: 11px; }
                        .alert-info { background-color: #d1ecf1; border-color: #bee5eb; color: #0c5460; }
                        .text-center { text-align: center; }
                        .text-muted { color: #6c757d; }
                        .profile-image-placeholder { 
                            width: 80px; 
                            height: 80px; 
                            border-radius: 40px; 
                            background-color: #f8f9fa;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            margin-bottom: 10px;
                        }
                        @@page { size: A4; margin: 1cm; }
                        @@media print {
                            .row { display: flex; flex-wrap: wrap; }
                            .col-lg-6 { width: 50%; float: left; }
                        }
                    </style>
                </head>
                <body>
                    <div class="text-center mb-3">
                        <h4>Student Profile</h4>
                        <h5>@Model.Surname, @Model.OtherNames</h5>
                        <small class="text-muted">Printed on @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</small>
                    </div>
                    ${printContents}
                </body>
                </html>
            `;

            window.print();
            document.body.innerHTML = originalContents;
        }
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            border-bottom: none;
            padding: 1rem 1.25rem;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }

        .profile-image-placeholder {
            width: 120px;
            height: 120px;
            border-radius: 60px;
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
        }

        dt {
            font-weight: 500;
            color: #6c757d;
            font-size: 0.9rem;
        }

        dd {
            margin-bottom: 0.5rem;
        }

        .collapse-toggle {
            cursor: pointer;
        }

        .card-header .btn-outline-primary {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }
    </style>
}