@model IEnumerable<PWCEPortal.Models.StudentInfo.ParentGuardian>
@{
    ViewBag.Title = "Parent/Guardian Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Parent/Guardian Records</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Student">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">Parents/Guardians</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-users me-2"></i>Parents & Guardians
            </h3>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-4">
                <a asp-action="AddParentGuardian" asp-route-studentId="@ViewBag.StudentId" class="btn btn-success">
                    <i class="fas fa-user-plus me-2"></i>Add New Parent/Guardian
                </a>
            </div>

            <div class="table-responsive">
                <table id="parentsTable" class="table table-hover table-striped">
                    <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Contact Information</th>
                        <th>Relationship</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.FullName</strong>
                            </td>
                            <td>
                                <div>@item.Email</div>
                                <div class="text-muted small">@item.Telephone</div>
                            </td>
                            <td>
                                    <span class="custom-badge @(item.Relationship == "Parent" ? "bg-primary" : "bg-secondary")">
                                        @item.Relationship
                                    </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="EditParentGuardian" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a class="btn btn-outline-danger btn-delete" asp-route-id="@item.Id" asp-action="DeleteParentGuardian" asp-controller="Student" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fas fa-users-slash fa-2x mb-3"></i>
                                <p>No parents/guardians found for this student</p>
                                <a asp-action="AddParentGuardian" asp-route-studentId="@ViewBag.StudentId" class="btn btn-success mt-2">
                                    <i class="fas fa-user-plus me-1"></i> Add First Parent/Guardian
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this parent/guardian record?</p>
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Warning:</strong> This will remove all contact information and emergency access for this person.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with search functionality
            $('#parentsTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search parents/guardians..."
                },
                columnDefs: [
                    { orderable: false, targets: [3] } // Disable sorting on actions column
                ]
            });

            // Delete confirmation modal
            $('.btn-delete').click(function() {
                var parentId = $(this).data('parent-id');
                var deleteUrl = '@Url.Action("DeleteParentGuardian")/' + parentId;
                $('#deleteForm').attr('action', deleteUrl);
                $('#deleteModal').modal('show');
            });
        });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .btn-outline-warning:hover,
        .btn-outline-danger:hover {
            color: white;
        }

        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }

        .empty-state {
            opacity: 0.7;
        }

        .modal-header {
            border-bottom: none;
        }
    </style>
}