@{
    ViewData["Title"] = "Upload Students";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Upload Students</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">Upload</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-file-upload me-2"></i>Upload Student Data
            </h3>
        </div>
        <div class="card-body">
            <form id="uploadForm" method="post" enctype="multipart/form-data">
                <div class="form-group mb-4">
                    <div class="form-floating">
                        <input type="file" name="file" id="file" class="form-control" accept=".xlsx" required />
                        <label for="file">Select Excel File (.xlsx)</label>
                    </div>
                    <div class="form-text">Maximum file size: 5MB</div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-upload me-1"></i> Upload
                </button>
            </form>

            <!-- Progress Bar -->
            <div class="progress mt-4" style="display: none;">
                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" style="width: 0%;" 
                     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
            </div>

            <!-- Upload Results -->
            <div id="uploadResults" class="mt-4"></div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-table me-2"></i>Excel File Format
            </h3>
        </div>
        <div class="card-body">
            <p>Ensure your Excel file follows this format:</p>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                    <tr>
                        <th></th>
                        <th>Application No.</th>
                        <th>Student ID</th>
                        <th>Title</th>
                        <th>Surname</th>
                        <th>Other Names</th>
                        <th>Gender</th>
                        <th>DoB</th>
                        <th>Phone No</th>
                        <th>Email</th>
                        <th>Current Level</th>
                        <th>Level of Entry</th>
                        <th>College Program</th>
                        <th>Enrolment Year</th>
                        <th>Expected Compt Year</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>1</td>
                        <td>12345</td>
                        <td>12345678</td>
                        <td>Miss</td>
                        <td>Doe</td>
                        <td>Mary</td>
                        <td>Female</td>
                        <td>01/01/2000</td>
                        <td>1234567890</td>
                        <td>mary.doe@12.com</td>
                        <td>100</td>
                        <td>100</td>
                        <td>PRIMARY EDUCATION</td>
                        <td>2024</td>
                        <td>2028</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Note:</strong> The College Program ID should match an existing program from the system.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#uploadForm').on('submit', function (e) {
                e.preventDefault();

                var formData = new FormData(this);
                var progressBar = $('#progressBar');
                var progressContainer = $('.progress');
                var uploadResults = $('#uploadResults');
                var submitButton = $(this).find('button[type="submit"]');

                // Clear previous results
                uploadResults.html('');
                
                // Show the progress bar and disable submit button
                progressContainer.show();
                submitButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Uploading...');

                $.ajax({
                    url: '@Url.Action("UploadStudents", "Student")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    xhr: function () {
                        var xhr = new XMLHttpRequest();
                        xhr.upload.addEventListener('progress', function (e) {
                            if (e.lengthComputable) {
                                var percent = Math.round((e.loaded / e.total) * 100);
                                progressBar.css('width', percent + '%').attr('aria-valuenow', percent).text(percent + '%');
                            }
                        }, false);
                        return xhr;
                    },
                    success: function (response) {
                        progressContainer.hide();
                        submitButton.prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Upload');

                        if (response.success) {
                            var successHtml = `
                                <div class="alert alert-success">
                                    <h5><i class="fas fa-check-circle me-2"></i>Upload Completed</h5>
                                    <p><strong>Successfully processed:</strong> ${response.successCount} records</p>
                                    ${response.errorCount > 0 ? 
                                        `<p class="mb-2"><strong>Errors encountered:</strong> ${response.errorCount} records</p>` : 
                                        ''}
                            `;

                            if (response.errors && response.errors.length > 0) {
                                successHtml += `
                                    <div class="mt-3">
                                        <h6>Error Details:</h6>
                                        <ul class="mb-0">
                                            ${response.errors.map(error => `<li>${error}</li>`).join('')}
                                        </ul>
                                    </div>
                                `;
                            }

                            successHtml += `</div>`;
                            uploadResults.html(successHtml);
                        } else {
                            uploadResults.html(`
                                <div class="alert alert-danger">
                                    <h5><i class="fas fa-exclamation-circle me-2"></i>Upload Failed</h5>
                                    <p class="mb-0">${response.message}</p>
                                </div>
                            `);
                        }
                    },
                    error: function (xhr) {
                        progressContainer.hide();
                        submitButton.prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Upload');
                        
                        var errorMessage = "An unexpected error occurred during the upload.";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        
                        uploadResults.html(`
                            <div class="alert alert-danger">
                                <h5><i class="fas fa-exclamation-circle me-2"></i>Upload Error</h5>
                                <p class="mb-0">${errorMessage}</p>
                            </div>
                        `);
                    }
                });
            });
        });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .form-floating label {
            color: #6c757d;
        }
        
        #file {
            padding-top: 2rem;
            height: calc(3.5rem + 2px);
        }
        
        .progress {
            height: 1.5rem;
            border-radius: 0.5rem;
        }
        
        .progress-bar {
            font-size: 0.875rem;
            font-weight: 500;
        }
    </style>
}