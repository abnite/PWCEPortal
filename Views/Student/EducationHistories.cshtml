@model IEnumerable<PWCEPortal.Models.StudentInfo.EducationHistory>
@{
    ViewBag.Title = "Education History";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Education History</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Student">Students</a></li>
                <li class="breadcrumb-item active" aria-current="page">Education History</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-graduation-cap me-2"></i>Academic Background
            </h3>
            <a asp-action="AddEducationHistory" asp-route-studentId="@ViewBag.StudentId" class="btn btn-success">
                <i class="fas fa-plus-circle me-1"></i> Add Record
            </a>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i> No education history records found. Add the first record.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="educationHistoryTable" class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Institution</th>
                                <th>Duration</th>
                                <th>Leadership</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.SchoolName</strong>
                                    </td>
                                    <td>
                                        @item.FromDate.ToString("MMM yyyy") - 
                                        @item.ToDate.ToString("MMM yyyy")
                                        <div class="text-muted small">
                                            @((item.ToDate - item.FromDate).Days/365) years
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.OfficeHeld))
                                        {
                                            <span class="custom-badge bg-success">@item.OfficeHeld</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None specified</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="EditEducationHistory" asp-route-id="@item.Id" 
                                               class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="DeleteEducationHistory" asp-route-id="@item.Id" 
                                               class="btn btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete this education record?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#educationHistoryTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search education history..."
                },
                columnDefs: [
                    { orderable: false, targets: [3] } // Disable sorting on actions column
                ]
            });
        });
    </script>
    
    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-outline-primary:hover, .btn-outline-danger:hover {
            color: white;
        }
        
        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
    </style>
}