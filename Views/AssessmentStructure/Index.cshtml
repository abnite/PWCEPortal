@model IEnumerable<PWCEPortal.Models.Academic.AssessmentStructure>
@{
    ViewBag.Title = "Assessment Structures";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Assessment Structures</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item active">Assessment Structures</li>
            </ol>
        </nav>
    </div>

    <div class="mb-3 d-flex gap-2 justify-content-end">
        @if (User.HasClaim("Permission", "Permissions.AssessmentStructure.Configure"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Structure</a>
        }
        @if (User.HasClaim("Permission", "Permissions.GradingScale.View"))
        {
            <a asp-action="GradingScales" class="btn btn-outline-secondary"><i class="fas fa-star-half-alt me-1"></i>Grading Scales</a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Programme</th>
                            <th>Level</th>
                            <th>Components</th>
                            <th>Total Weight</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var totalWeight = s.Components?.Sum(c => c.WeightPercent) ?? 0;
                            <tr>
                                <td><strong>@s.Name</strong></td>
                                <td>@(s.CollegeProgram?.ProgramName ?? "<em>All Programmes</em>")</td>
                                <td>@(s.ApplicableLevel.HasValue ? $"Level {s.ApplicableLevel}" : "All Levels")</td>
                                <td><span class="badge bg-info text-dark">@(s.Components?.Count ?? 0)</span></td>
                                <td>
                                    <span class="badge @(totalWeight == 100 ? "bg-success" : "bg-warning text-dark")">
                                        @totalWeight%
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info me-1">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.HasClaim("Permission", "Permissions.AssessmentStructure.Configure"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this structure?')">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">No assessment structures configured yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
