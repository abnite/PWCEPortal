@model PWCEPortal.ViewModel.Assessment.AssessmentStructureViewModel
@{
    ViewBag.Title = "Create Assessment Structure";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Create Assessment Structure</h1>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Structure Details</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" id="structureForm">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CollegeProgramId" class="form-label">Programme (leave blank for all)</label>
                        <select asp-for="CollegeProgramId" class="form-select">
                            <option value="">-- All Programmes --</option>
                            @foreach (var p in Model.Programs)
                            {
                                <option value="@p.Id">@p.ProgramName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ApplicableLevel" class="form-label">Level (leave blank for all)</label>
                        <select asp-for="ApplicableLevel" class="form-select">
                            <option value="">-- All Levels --</option>
                            <option value="100">Level 100</option>
                            <option value="200">Level 200</option>
                            <option value="300">Level 300</option>
                            <option value="400">Level 400</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <h5>Assessment Components <small class="text-muted">(weights must total 100%)</small></h5>
                <div id="componentsList">
                    @for (int i = 0; i < Model.Components.Count; i++)
                    {
                        <div class="row g-2 mb-2 component-row">
                            <input type="hidden" name="Components[@i].DisplayOrder" value="@(i+1)" />
                            <div class="col-md-4">
                                <input name="Components[@i].ComponentName" class="form-control" placeholder="Component Name (e.g., Final Exam)" required />
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <input name="Components[@i].WeightPercent" type="number" step="0.01" min="1" max="100" class="form-control weight-input" placeholder="Weight %" required />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <input name="Components[@i].MaxScore" type="number" step="0.01" min="1" class="form-control" placeholder="Max Score" value="100" required />
                                    <span class="input-group-text">pts</span>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger remove-row"><i class="fas fa-minus"></i></button>
                            </div>
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <button type="button" id="addComponent" class="btn btn-outline-success btn-sm">
                        <i class="fas fa-plus me-1"></i>Add Component
                    </button>
                    <span class="ms-3 text-muted">Total: <strong id="totalWeight">0</strong>%</span>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Structure</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let componentIndex = @Model.Components.Count;

    function updateTotal() {
        let total = 0;
        document.querySelectorAll('.weight-input').forEach(i => total += parseFloat(i.value) || 0);
        document.getElementById('totalWeight').textContent = total.toFixed(1);
        document.getElementById('totalWeight').className = Math.abs(total - 100) < 0.01 ? 'text-success fw-bold' : 'text-danger fw-bold';
    }

    document.getElementById('addComponent').addEventListener('click', function () {
        const row = `<div class="row g-2 mb-2 component-row">
            <input type="hidden" name="Components[${componentIndex}].DisplayOrder" value="${componentIndex + 1}" />
            <div class="col-md-4"><input name="Components[${componentIndex}].ComponentName" class="form-control" placeholder="Component Name" required /></div>
            <div class="col-md-3"><div class="input-group"><input name="Components[${componentIndex}].WeightPercent" type="number" step="0.01" min="1" max="100" class="form-control weight-input" placeholder="Weight %" required /><span class="input-group-text">%</span></div></div>
            <div class="col-md-3"><div class="input-group"><input name="Components[${componentIndex}].MaxScore" type="number" step="0.01" min="1" class="form-control" placeholder="Max Score" value="100" required /><span class="input-group-text">pts</span></div></div>
            <div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-row"><i class="fas fa-minus"></i></button></div>
        </div>`;
        document.getElementById('componentsList').insertAdjacentHTML('beforeend', row);
        componentIndex++;
        bindEvents();
    });

    function bindEvents() {
        document.querySelectorAll('.remove-row').forEach(btn => {
            btn.onclick = function () { this.closest('.component-row').remove(); updateTotal(); };
        });
        document.querySelectorAll('.weight-input').forEach(inp => { inp.oninput = updateTotal; });
    }
    bindEvents();
    updateTotal();
</script>
}
