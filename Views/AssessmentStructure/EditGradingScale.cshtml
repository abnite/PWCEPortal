@model PWCEPortal.ViewModel.Assessment.GradingScaleViewModel
@{
    ViewBag.Title = "Edit Grading Scale";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Grading Scale</h1>
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-warning"><h5 class="mb-0">Edit Scale</h5></div>
        <div class="card-body">
            <form asp-action="EditGradingScale" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="ScaleName" class="form-label"></label>
                        <input asp-for="ScaleName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                            <label asp-for="IsDefault" class="form-check-label">Default Scale</label>
                        </div>
                    </div>
                </div>

                <h5>Grade Bands</h5>
                <div class="table-responsive">
                    <table class="table table-bordered" id="gradesTable">
                        <thead class="table-light">
                            <tr><th>Grade</th><th>Min %</th><th>Max %</th><th>Grade Point</th><th>Remark</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Grades.Count; i++)
                            {
                                <tr class="grade-row">
                                    <td><input name="Grades[@i].GradeLetter" class="form-control" value="@Model.Grades[i].GradeLetter" required /></td>
                                    <td><input name="Grades[@i].MinScore" type="number" step="0.01" class="form-control" value="@Model.Grades[i].MinScore" required /></td>
                                    <td><input name="Grades[@i].MaxScore" type="number" step="0.01" class="form-control" value="@Model.Grades[i].MaxScore" required /></td>
                                    <td><input name="Grades[@i].GradePoint" type="number" step="0.1" class="form-control" value="@Model.Grades[i].GradePoint" required /></td>
                                    <td><input name="Grades[@i].Remark" class="form-control" value="@Model.Grades[i].Remark" /></td>
                                    <td><button type="button" class="btn btn-outline-danger btn-sm remove-grade"><i class="fas fa-minus"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" id="addGrade" class="btn btn-outline-success btn-sm mb-3">
                    <i class="fas fa-plus me-1"></i>Add Grade Band
                </button>

                <div class="d-flex gap-2 justify-content-end mt-3">
                    <a asp-action="GradingScales" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning">Update Scale</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let gradeIndex = @Model.Grades.Count;
    document.getElementById('addGrade').addEventListener('click', function () {
        const row = `<tr class="grade-row">
            <td><input name="Grades[${gradeIndex}].GradeLetter" class="form-control" required /></td>
            <td><input name="Grades[${gradeIndex}].MinScore" type="number" step="0.01" class="form-control" required /></td>
            <td><input name="Grades[${gradeIndex}].MaxScore" type="number" step="0.01" class="form-control" required /></td>
            <td><input name="Grades[${gradeIndex}].GradePoint" type="number" step="0.1" class="form-control" required /></td>
            <td><input name="Grades[${gradeIndex}].Remark" class="form-control" /></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm remove-grade"><i class="fas fa-minus"></i></button></td>
        </tr>`;
        document.querySelector('#gradesTable tbody').insertAdjacentHTML('beforeend', row);
        gradeIndex++;
        document.querySelectorAll('.remove-grade').forEach(b => { b.onclick = function() { this.closest('tr').remove(); }; });
    });
    document.querySelectorAll('.remove-grade').forEach(b => { b.onclick = function() { this.closest('tr').remove(); }; });
</script>
}
