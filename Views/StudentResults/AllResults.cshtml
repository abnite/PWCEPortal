@model PWCEPortal.ViewModel.Results.ResultsPublishViewModel
@{
    ViewBag.Title = "All Results";
    Layout = "_AdminLayout";
    var semesters = ViewBag.Semesters as IEnumerable<PWCEPortal.Models.Academic.AcademicSemester>;
    var selectedId = ViewBag.SelectedSemesterId as Guid?;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Student Results</h1>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <form method="get">
                <select name="semesterId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Select Semester --</option>
                    @foreach (var s in semesters ?? new List<PWCEPortal.Models.Academic.AcademicSemester>())
                    {
                        <option value="@s.Id" selected="@(s.Id == selectedId)">@s.AcademicYear?.Year – @s.SemesterName</option>
                    }
                </select>
            </form>
        </div>

        @if (Model.Semester != null && User.HasClaim("Permission", "Permissions.StudentResults.ViewAll"))
        {
            <div class="col-md-auto ms-auto d-flex gap-2">
                <form asp-action="Compute" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="semesterId" value="@Model.Semester.Id" />
                    <button type="submit" class="btn btn-outline-primary" onclick="return confirm('Compute GPA for all students?')">
                        <i class="fas fa-calculator me-1"></i>Compute Results
                    </button>
                </form>
                @if (User.HasClaim("Permission", "Permissions.StudentResults.Publish") && Model.Results.Any())
                {
                    <form asp-action="Publish" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="semesterId" value="@Model.Semester.Id" />
                        <button type="submit" class="btn btn-success" onclick="return confirm('Publish all results for this semester?')">
                            <i class="fas fa-bullhorn me-1"></i>Publish Results
                        </button>
                    </form>
                }
            </div>
        }
    </div>

    @* ── Pending / Interim Publish Section ── *@
    @if (Model.Semester != null && Model.PendingSubmissions.Any() && User.HasClaim("Permission", "Permissions.StudentResults.Publish"))
    {
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-upload me-2"></i>Approved Assessments — Publish Controls</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course</th>
                                <th>Code</th>
                                <th class="text-center">Marks Status</th>
                                <th class="text-center">Interim Published</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PendingSubmissions)
                            {
                                <tr>
                                    <td><strong>@p.CourseName</strong></td>
                                    <td><span class="custom-badge bg-secondary">@p.CourseCode</span></td>
                                    <td class="text-center">
                                        @if (p.IsComplete)
                                        {
                                            <span class="custom-badge bg-success">All Marks Complete</span>
                                        }
                                        else
                                        {
                                            <span class="custom-badge bg-warning text-dark">Partial (Some Pending)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (p.IsInterimPublished)
                                        {
                                            <span class="custom-badge bg-info text-dark">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!p.IsInterimPublished && !p.IsComplete)
                                        {
                                            <form asp-action="PublishInterim" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="assignmentId" value="@p.AssignmentId" />
                                                <input type="hidden" name="semesterId" value="@Model.Semester.Id" />
                                                <button type="submit" class="btn btn-sm btn-warning text-dark"
                                                        onclick="return confirm('Publish provisional marks for @p.CourseName? Students with ≥70% fee payment will see these marks.')">
                                                    <i class="fas fa-eye me-1"></i>Publish Interim
                                                </button>
                                            </form>
                                        }
                                        else if (p.IsComplete)
                                        {
                                            <span class="text-success small"><i class="fas fa-check-circle me-1"></i>Ready for final Compute &amp; Publish</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Already interim published</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.Semester != null)
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card text-center p-3 bg-light">
                    <h4>@Model.Results.Count</h4><p class="mb-0">Total Students</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center p-3 bg-success text-white">
                    <h4>@Model.PublishedCount</h4><p class="mb-0">Published</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center p-3 bg-warning">
                    <h4>@Model.WithheldCount</h4><p class="mb-0">Withheld</p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="table1" class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Student ID</th>
                                <th>GPA</th>
                                <th>Credit Hours</th>
                                <th>Published</th>
                                <th>Withheld</th>
                                @if (User.HasClaim("Permission", "Permissions.StudentResults.Withhold"))
                                {
                                    <th class="text-center">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Results)
                            {
                                <tr>
                                    <td>@r.Student?.Surname @r.Student?.OtherNames</td>
                                    <td>@r.Student?.StudentID</td>
                                    <td><strong>@r.GPA.ToString("F2")</strong></td>
                                    <td>@r.TotalCreditHours</td>
                                    <td>@(r.IsPublished ? "Yes" : "No")</td>
                                    <td>
                                        @if (r.IsWithheld)
                                        {
                                            <span class="custom-badge bg-warning text-dark">Yes – @r.WithholdReason</span>
                                        }
                                        else { <span>No</span> }
                                    </td>
                                    @if (User.HasClaim("Permission", "Permissions.StudentResults.Withhold"))
                                    {
                                        <td class="text-center">
                                            @if (r.IsWithheld)
                                            {
                                                <form asp-action="UnWithhold" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="studentId" value="@r.StudentId" />
                                                    <input type="hidden" name="semesterId" value="@Model.Semester.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                                            onclick="return confirm('Un-withhold and re-publish this result?')">
                                                        Un-Withhold
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-warning"
                                                        onclick="withholdResult('@r.StudentId','@Model.Semester.Id')">
                                                    Withhold
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
function withholdResult(studentId, semesterId) {
    const reason = prompt('Reason for withholding result:');
    if (!reason) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '@Url.Action("Withhold","StudentResults")';
    form.innerHTML = `@Html.AntiForgeryToken()
        <input name="studentId" value="${studentId}" />
        <input name="semesterId" value="${semesterId}" />
        <input name="reason" value="${reason}" />`;
    document.body.appendChild(form);
    form.submit();
}
</script>
}
