@model PWCEPortal.ViewModel.Results.StudentResultsViewModel
@{
    ViewBag.Title = "My Results";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Academic Results</h1>
    <p class="text-muted">@Model.Student.Surname @Model.Student.OtherNames &bull; @Model.Student.StudentID &bull; @Model.Student.CollegeProgram?.ProgramName</p>

    @if (Model.CumulativeResult != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary text-center p-3">
                    <h2 class="fw-bold">@Model.CumulativeResult.CGPA.ToString("F2")</h2>
                    <p class="mb-0">Cumulative GPA</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success text-center p-3">
                    <h2 class="fw-bold">@Model.CumulativeResult.Classification</h2>
                    <p class="mb-0">Classification</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info text-center p-3">
                    <h2 class="fw-bold">@Model.CumulativeResult.TotalCreditHoursEarned</h2>
                    <p class="mb-0">Credit Hours Earned</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">Results have not been published yet.</div>
    }

    @* ── Provisional / Interim Results ── *@
    @if (Model.InterimResults.Any())
    {
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="fas fa-hourglass-half fa-lg me-3"></i>
            <div>
                <strong>Provisional Results</strong> — Some components are awaiting external marking.
                The scores below are <em>not final</em> and will not be used for GPA or grade calculation
                until all components are received and finally published.
            </div>
        </div>

        @{
            var interimBySemester = Model.InterimResults
                .GroupBy(r => new { r.SemesterId, r.SemesterName, r.AcademicYear })
                .OrderBy(g => g.Key.AcademicYear).ThenBy(g => g.Key.SemesterName);
        }

        @foreach (var group in interimBySemester)
        {
            <div class="card shadow-sm mb-4 border-warning">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-hourglass-half me-2"></i>@group.Key.AcademicYear – @group.Key.SemesterName &nbsp;<span class="custom-badge bg-dark">Provisional</span></h6>
                </div>
                @foreach (var course in group.OrderBy(c => c.CourseCode))
                {
                    <div class="card-body border-top py-3">
                        <h6 class="mb-2"><span class="custom-badge bg-secondary me-2">@course.CourseCode</span>@course.CourseName</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-1" style="max-width:600px">
                                <thead class="table-light">
                                    <tr>
                                        <th>Component</th>
                                        <th class="text-center">Weight</th>
                                        <th class="text-center">Score / Max</th>
                                        <th class="text-center">Contribution</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var comp in course.Components)
                                    {
                                        <tr>
                                            <td>@comp.ComponentName</td>
                                            <td class="text-center">@comp.WeightPercent%</td>
                                            <td class="text-center">
                                                @if (comp.Score.HasValue)
                                                {
                                                    <span>@comp.Score.Value.ToString("F1") / @comp.MaxScore</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Pending</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (comp.WeightedContribution.HasValue)
                                                {
                                                    <span>@comp.WeightedContribution.Value.ToString("F1")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="2" class="fw-bold text-end">Provisional Total</td>
                                        <td class="text-center fw-bold">out of @course.AvailableTotalWeight%</td>
                                        <td class="text-center fw-bold text-warning">@course.AvailableWeightedScore.ToString("F1")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <small class="text-muted">Final grade and GPA will be computed once all components are received.</small>
                    </div>
                }
            </div>
        }
    }

    @if (Model.SemesterResults.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light"><h5 class="mb-0">Semester Results</h5></div>
            <div class="card-body p-0">
                <div class="accordion" id="semesterAccordion">
                    @{int semIdx = 0;}
                    @foreach (var r in Model.SemesterResults)
                    {
                        var collapseId = $"collapse-{r.Id}";
                        var headingId  = $"heading-{r.Id}";
                        var courses    = Model.CourseResultsBySemester.TryGetValue(r.AcademicSemesterId, out var cl) ? cl : new List<PWCEPortal.ViewModel.Results.CourseResultViewModel>();
                        semIdx++;
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(semIdx == 1 ? "" : "collapsed")" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                        aria-expanded="@(semIdx == 1 ? "true" : "false")" aria-controls="@collapseId">
                                    <div class="d-flex w-100 justify-content-between pe-3">
                                        <span><strong>@r.AcademicSemester?.AcademicYear?.Year</strong> &ndash; @r.AcademicSemester?.SemesterName</span>
                                        <span>
                                            GPA: <strong class="text-primary">@r.GPA.ToString("F2")</strong>
                                            &nbsp;|&nbsp; Credits: <strong>@r.TotalCreditHours</strong>
                                        </span>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse @(semIdx == 1 ? "show" : "")"
                                 aria-labelledby="@headingId" data-bs-parent="#semesterAccordion">
                                <div class="accordion-body p-0">
                                    @if (courses.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-sm mb-0 align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Course Code</th>
                                                        <th>Course Name</th>
                                                        <th class="text-center">Credits</th>
                                                        <th class="text-center">Score (%)</th>
                                                        <th class="text-center">Grade</th>
                                                        <th class="text-center">Grade Point</th>
                                                        <th class="text-center">Quality Points</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var c in courses)
                                                    {
                                                        <tr>
                                                            <td><span class="custom-badge bg-secondary">@c.CourseCode</span></td>
                                                            <td>@c.CourseName</td>
                                                            <td class="text-center">@c.CreditHours</td>
                                                            <td class="text-center">@c.TotalScore.ToString("F1")</td>
                                                            <td class="text-center">
                                                                <strong class="@(c.GradeLetter == "-" ? "text-muted" : "text-success")">@c.GradeLetter</strong>
                                                            </td>
                                                            <td class="text-center">@c.GradePoint.ToString("F2")</td>
                                                            <td class="text-center">@c.QualityPoints.ToString("F2")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot class="table-light">
                                                    <tr>
                                                        <td colspan="2" class="text-end fw-bold">Semester Total</td>
                                                        <td class="text-center fw-bold">@r.TotalCreditHours</td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td class="text-center fw-bold">@courses.Sum(c => c.QualityPoints).ToString("F2")</td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="7" class="text-end">
                                                            Semester GPA: <strong class="text-primary">@r.GPA.ToString("F2")</strong>
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted p-3 mb-0">No course detail available for this semester.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (User.HasClaim("Permission", "Permissions.Transcripts.GenerateOwn"))
        {
            <div class="mt-3">
                <a asp-controller="Transcript" asp-action="MyTranscript" class="btn btn-outline-primary">
                    <i class="fas fa-file-alt me-1"></i>Generate Transcript
                </a>
            </div>
        }
    }
</div>
