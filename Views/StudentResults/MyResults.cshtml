@model PWCEPortal.ViewModel.Results.StudentResultsViewModel
@{
    ViewBag.Title = "My Results";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Academic Results</h1>
    <p class="text-muted">@Model.Student.Surname @Model.Student.OtherNames &bull; @Model.Student.StudentID &bull; @Model.Student.CollegeProgram?.ProgramName</p>

    @if (Model.CumulativeResult != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary text-center p-3">
                    <h2 class="fw-bold">@Model.CumulativeResult.CGPA.ToString("F2")</h2>
                    <p class="mb-0">Cumulative GPA</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success text-center p-3">
                    <h2 class="fw-bold">@Model.CumulativeResult.Classification</h2>
                    <p class="mb-0">Classification</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info text-center p-3">
                    <h2 class="fw-bold">@Model.CumulativeResult.TotalCreditHoursEarned</h2>
                    <p class="mb-0">Credit Hours Earned</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">Results have not been published yet.</div>
    }

    @if (Model.SemesterResults.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light"><h5 class="mb-0">Semester Results</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr><th>Academic Year</th><th>Semester</th><th>GPA</th><th>Credit Hours</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.SemesterResults)
                            {
                                <tr>
                                    <td>@r.AcademicSemester?.AcademicYear?.Year</td>
                                    <td>@r.AcademicSemester?.SemesterName</td>
                                    <td><strong>@r.GPA.ToString("F2")</strong></td>
                                    <td>@r.TotalCreditHours</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (User.HasClaim("Permission", "Permissions.Transcripts.GenerateOwn"))
        {
            <div class="mt-3">
                <a asp-controller="Transcript" asp-action="MyTranscript" class="btn btn-outline-primary">
                    <i class="fas fa-file-alt me-1"></i>Generate Transcript
                </a>
            </div>
        }
    }
</div>
