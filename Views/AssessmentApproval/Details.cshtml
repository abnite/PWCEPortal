@model PWCEPortal.Models.Academic.AssessmentSubmission
@{
    ViewBag.Title = "Submission Details";
    Layout = "_AdminLayout";
    var logs = ViewBag.Logs as IEnumerable<PWCEPortal.Models.Academic.AssessmentApprovalLog>;
    var status = Model.Status;
    bool canHODApprove = User.HasClaim("Permission", "Permissions.AssessmentApproval.HODApprove")
                      && status == PWCEPortal.Models.Academic.SubmissionStatus.SubmittedForReview;
    bool canHODReject  = User.HasClaim("Permission", "Permissions.AssessmentApproval.HODReject")
                      && status == PWCEPortal.Models.Academic.SubmissionStatus.SubmittedForReview;
    bool canQAApprove  = User.HasClaim("Permission", "Permissions.AssessmentApproval.QAApprove")
                      && status == PWCEPortal.Models.Academic.SubmissionStatus.HODApproved;
    bool canQAFlag     = User.HasClaim("Permission", "Permissions.AssessmentApproval.QAFlag")
                      && status == PWCEPortal.Models.Academic.SubmissionStatus.HODApproved;
    bool canPrincipal  = User.HasClaim("Permission", "Permissions.AssessmentApproval.PrincipalApprove")
                      && status == PWCEPortal.Models.Academic.SubmissionStatus.QAApproved;
    bool canUnlock     = User.HasClaim("Permission", "Permissions.AssessmentApproval.UnlockAssessment")
                      && status == PWCEPortal.Models.Academic.SubmissionStatus.PrincipalApproved;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">@Model.CourseLecturerAssignment?.Course?.CourseName</h1>
        <a asp-action="Pending" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light"><h5 class="mb-0">Submission Info</h5></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Lecturer</dt>
                        <dd class="col-sm-7">@Model.CourseLecturerAssignment?.Lecturer?.User?.LastName @Model.CourseLecturerAssignment?.Lecturer?.User?.FirstName</dd>
                        <dt class="col-sm-5">Semester</dt>
                        <dd class="col-sm-7">@Model.CourseLecturerAssignment?.AcademicSemester?.SemesterName</dd>
                        <dt class="col-sm-5">Submitted</dt>
                        <dd class="col-sm-7">@Model.SubmittedAt?.ToString("dd MMM yyyy HH:mm")</dd>
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7"><span class="badge bg-warning text-dark">@Model.Status</span></dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <!-- Action Cards -->
            @if (canHODApprove || canHODReject)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-info text-white"><h5 class="mb-0">HOD Review</h5></div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Comments</label>
                            <textarea id="hodComments" class="form-control" rows="2"></textarea>
                        </div>
                        @if (canHODApprove)
                        {
                            <form asp-action="HODApprove" method="post" class="d-inline me-2"
                                  onsubmit="return submitWithComments(this,'hodComments')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="comments" id="hodApproveComments" />
                                <button type="submit" class="btn btn-success"><i class="fas fa-check me-1"></i>Approve</button>
                            </form>
                        }
                        @if (canHODReject)
                        {
                            <form asp-action="HODReject" method="post" class="d-inline"
                                  onsubmit="return submitWithComments(this,'hodComments')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="comments" id="hodRejectComments" />
                                <button type="submit" class="btn btn-danger"><i class="fas fa-times me-1"></i>Reject</button>
                            </form>
                        }
                    </div>
                </div>
            }

            @if (canQAApprove || canQAFlag)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white"><h5 class="mb-0">QA Review</h5></div>
                    <div class="card-body">
                        <textarea id="qaComments" class="form-control mb-2" rows="2" placeholder="QA Comments"></textarea>
                        @if (canQAApprove)
                        {
                            <form asp-action="QAApprove" method="post" class="d-inline me-2"
                                  onsubmit="return submitWithComments(this,'qaComments')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="comments" />
                                <button type="submit" class="btn btn-success">Approve</button>
                            </form>
                        }
                        @if (canQAFlag)
                        {
                            <form asp-action="QAFlag" method="post" class="d-inline"
                                  onsubmit="return submitWithComments(this,'qaComments')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="comments" />
                                <button type="submit" class="btn btn-warning text-dark">Flag for Revision</button>
                            </form>
                        }
                    </div>
                </div>
            }

            @if (canPrincipal)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-success text-white"><h5 class="mb-0">Principal Approval</h5></div>
                    <div class="card-body">
                        <textarea id="principalComments" class="form-control mb-2" rows="2" placeholder="Comments"></textarea>
                        <form asp-action="PrincipalApprove" method="post"
                              onsubmit="return submitWithComments(this,'principalComments')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="comments" />
                            <button type="submit" class="btn btn-success"><i class="fas fa-stamp me-1"></i>Final Approve</button>
                        </form>
                    </div>
                </div>
            }

            @if (canUnlock)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-danger text-white"><h5 class="mb-0">Unlock for Correction</h5></div>
                    <div class="card-body">
                        <textarea id="unlockReason" class="form-control mb-2" rows="2" placeholder="Reason for unlock"></textarea>
                        <form asp-action="Unlock" method="post"
                              onsubmit="return submitWithComments(this,'unlockReason')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="reason" />
                            <button type="submit" class="btn btn-danger">Unlock</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Approval History -->
    <div class="card shadow-sm">
        <div class="card-header"><h5 class="mb-0"><i class="fas fa-history me-2"></i>Approval History</h5></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Actor</th><th>Action</th><th>Comments</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs ?? new List<PWCEPortal.Models.Academic.AssessmentApprovalLog>())
                        {
                            <tr>
                                <td>@log.ActionDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@log.Actor?.LastName @log.Actor?.FirstName</td>
                                <td><span class="badge bg-secondary">@log.Action</span></td>
                                <td>@log.Comments</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function submitWithComments(form, textareaId) {
    const comments = document.getElementById(textareaId).value;
    const hiddenField = form.querySelector('input[name="comments"], input[name="reason"]');
    if (hiddenField) hiddenField.value = comments;
    return true;
}
</script>
}
