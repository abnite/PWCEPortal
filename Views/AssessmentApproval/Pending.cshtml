@model IEnumerable<PWCEPortal.Models.Academic.AssessmentSubmission>
@{
    ViewBag.Title = "Pending Approvals";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Assessment Approval Queue</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h5 class="mb-0"><i class="fas fa-tasks me-2"></i>Pending Submissions</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course</th>
                            <th>Lecturer</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var badgeClass = s.Status switch
                            {
                                PWCEPortal.Models.Academic.SubmissionStatus.SubmittedForReview => "bg-warning text-dark",
                                PWCEPortal.Models.Academic.SubmissionStatus.HODApproved => "bg-info text-dark",
                                PWCEPortal.Models.Academic.SubmissionStatus.HODRejected => "bg-danger",
                                PWCEPortal.Models.Academic.SubmissionStatus.QAApproved => "bg-primary",
                                PWCEPortal.Models.Academic.SubmissionStatus.QAFlagged => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><strong>@s.CourseLecturerAssignment?.Course?.CourseName</strong></td>
                                <td>@s.CourseLecturerAssignment?.Lecturer?.User?.LastName @s.CourseLecturerAssignment?.Lecturer?.User?.FirstName</td>
                                <td>@s.SubmittedAt?.ToString("dd MMM yyyy")</td>
                                <td><span class="custom-badge @badgeClass">@s.Status</span></td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info me-1">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted">No pending submissions.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
