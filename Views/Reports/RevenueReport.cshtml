@model PWCEPortal.ApplicationClass.PaginatedList<PWCEPortal.Models.Payment.Payment>
@{
    ViewBag.Title = "Payment Report";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Payment Report</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Payments</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-money-bill-wave me-2"></i>Financial Transactions
            </h3>
        </div>
        <div class="card-body">
            <form method="get" asp-action="RevenueReport" class="mb-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input type="date" name="startDate"
                                   value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : "")"
                                   class="form-control" id="startDate" />
                            <label for="startDate">Start Date</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input type="date" name="endDate"
                                   value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : "")"
                                   class="form-control" id="endDate" />
                            <label for="endDate">End Date</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="text" name="searchTerm"
                                   value="@ViewBag.SearchTerm"
                                   class="form-control"
                                   id="searchTerm"
                                   placeholder="Search by name or reference" />
                            <label for="searchTerm">Search Term</label>
                        </div>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary h-100">
                            <i class="fas fa-filter me-1"></i> Apply Filters
                        </button>
                    </div>
                </div>
            </form>
            <div class="mb-3">
                <a class="btn btn-outline-success" href="@Url.Action("ExportPaymentSummaryReport", "Reports", new { startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, searchTerm = ViewBag.SearchTerm })">
                    <i class="fas fa-file-excel me-1"></i> Export to Excel
                </a>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card border-success mb-3">
                        <div class="card-header bg-success text-white">
                            <i class="fas fa-check-circle me-2"></i> Verified Payments
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">GHS @ViewBag.TotalFeesCollected</h3>
                            <p class="card-text">Total fees collected</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Student</th>
                        <th>Amount</th>
                        <th>Reference</th>
                        <th>Bank Reference</th>
                        <th>Status</th>
                        <th>Verified By</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>
                                <span class="text-nowrap">@payment.PaymentDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                @payment.Student?.Surname @payment.Student?.OtherNames
                                <small class="text-muted d-block">@payment.Student?.ApplicationNumber</small>
                            </td>
                            <td class="fw-bold">GHS @payment.AmountPaid</td>
                            <td>
                                <span class="custom-badge bg-light text-dark">@payment.PaymentReference</span>
                            </td>
                            <td>
                                <span class="custom-badge bg-light text-dark">@payment.BankReferenceNumber</span>
                            </td>
                            <td>
                                @if (payment.IsVerified)
                                {
                                    <span class="custom-badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i> Verified
                                        </span>
                                }
                                else
                                {
                                    <span class="custom-badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i> Pending
                                        </span>
                                }
                            </td>
                            <td>
                                @payment.VerifiedBy?.FirstName @payment.VerifiedBy?.LastName
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                        data-bs-target="#detailsModal-@payment.Id">
                                    <i class="fas fa-info-circle"></i> Details
                                </button>
                            </td>
                        </tr>

                        <!-- Details Modal for each payment -->
                        <div class="modal fade" id="detailsModal-@payment.Id" tabindex="-1" aria-labelledby="detailsModalLabel-@payment.Id" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title" id="detailsModalLabel-@payment.Id">
                                            <i class="fas fa-file-invoice-dollar me-2"></i>Payment Details
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6 class="text-primary mb-3">Payment Information</h6>
                                                <dl class="row">
                                                    <dt class="col-sm-5">Payment Date:</dt>
                                                    <dd class="col-sm-7">@payment.PaymentDate.ToString("dd MMMM yyyy")</dd>

                                                    <dt class="col-sm-5">Amount Paid:</dt>
                                                    <dd class="col-sm-7">GHS @payment.AmountPaid</dd>

                                                    <dt class="col-sm-5">Payment Method:</dt>
                                                    <dd class="col-sm-7">@payment.PaymentMethod</dd>

                                                    <dt class="col-sm-5">Payment Reference:</dt>
                                                    <dd class="col-sm-7">@payment.PaymentReference</dd>

                                                    <dt class="col-sm-5">Bank Reference:</dt>
                                                    <dd class="col-sm-7">@payment.BankReferenceNumber</dd>
                                                </dl>
                                            </div>
                                            <div class="col-md-6">
                                                <h6 class="text-primary mb-3">Student Information</h6>
                                                <dl class="row">
                                                    <dt class="col-sm-5">Student Name:</dt>
                                                    <dd class="col-sm-7">@payment.Student?.Surname @payment.Student?.OtherNames</dd>

                                                    <dt class="col-sm-5">Application Number:</dt>
                                                    <dd class="col-sm-7">@payment.Student?.ApplicationNumber</dd>

                                                    <dt class="col-sm-5">Program:</dt>
                                                    <dd class="col-sm-7">@payment.Student?.CollegeProgram?.ProgramName</dd>

                                                    <dt class="col-sm-5">Level:</dt>
                                                    <dd class="col-sm-7">Level @payment.Student?.CurrentLevel</dd>
                                                </dl>
                                            </div>
                                        </div>

                                        <div class="mt-4">
                                            <h6 class="text-primary mb-3">Verification Details</h6>
                                            <dl class="row">
                                                <dt class="col-sm-3">Status:</dt>
                                                <dd class="col-sm-9">
                                                    @if (payment.IsVerified)
                                                    {
                                                        <span class="custom-badge bg-success">
                                                                <i class="fas fa-check-circle me-1"></i> Verified
                                                            </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="custom-badge bg-warning text-dark">
                                                                <i class="fas fa-clock me-1"></i> Pending Verification
                                                            </span>
                                                    }
                                                </dd>

                                                @if (payment.IsVerified)
                                                {
                                                    <dt class="col-sm-3">Verified By:</dt>
                                                    <dd class="col-sm-9">@payment.VerifiedBy?.FirstName @payment.VerifiedBy?.LastName (@payment.VerifiedBy?.Email)</dd>

                                                    <dt class="col-sm-3">Verification Date:</dt>
                                                    <dd class="col-sm-9">@payment.VerifiedDate?.ToString("dd MMMM yyyy")</dd>
                                                }
                                            </dl>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            <i class="fas fa-times me-1"></i> Close
                                        </button>
                                        @if (!payment.IsVerified)
                                        {
                                            <a asp-action="VerifyPayment" asp-route-id="@payment.Id" class="btn btn-success">
                                                <i class="fas fa-check-circle me-1"></i> Verify Payment
                                            </a>
                                        }
                                       <!-- <a asp-action="PrintReceipt" asp-route-id="@payment.Id" class="btn btn-primary" target="_blank">
                                            <i class="fas fa-print me-1"></i> Print Receipt
                                        </a>-->
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fas fa-money-bill-wave fa-2x mb-3"></i>
                                <p>No payments found matching your criteria</p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("RevenueReport", new { pageIndex = Model.PageIndex - 1, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, searchTerm = ViewBag.SearchTerm })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("RevenueReport", new { pageIndex = i, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, searchTerm = ViewBag.SearchTerm })">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("RevenueReport", new { pageIndex = Model.PageIndex + 1, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, searchTerm = ViewBag.SearchTerm })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>


<style>
    .card {
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }
    .badge {
        font-weight: 500;
        padding: 0.5em 0.75em;
    }
    .text-nowrap {
        white-space: nowrap;
    }
    .modal-content {
        border: none;
        border-radius: 10px;
    }
    .modal-header {
        border-bottom: none;
    }
</style>
