@model PWCEPortal.ApplicationClass.PaginatedList<PWCEPortal.Models.Payment.LegacyOutstandingFee>

@{
    ViewBag.Title = "Legacy Outstanding Fees";
    Layout = "_AdminLayout";
    var academicYears = ViewBag.AcademicYears as List<string>;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Legacy Outstanding Fees</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Legacy Outstanding</li>
            </ol>
        </nav>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <i class="fas fa-exclamation-circle me-2"></i>Total Legacy Outstanding
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        GHS @(((decimal)ViewBag.TotalLegacyOutstanding).ToString("N2"))
                    </h3>
                    <p class="card-text">Total of all imported previous balances.</p>
                </div>
            </div>
        </div>
        <div class="col-md-8 text-md-end mt-3 mt-md-0">
            <a asp-action="ExportLegacyOutstandingFees"
               asp-route-searchTerm="@ViewBag.SearchTerm"
               asp-route-academicYear="@ViewBag.AcademicYear"
               asp-route-startDate="@ViewBag.StartDate"
               asp-route-endDate="@ViewBag.EndDate"
               class="btn btn-outline-success">
                <i class="fas fa-file-excel me-1"></i> Export to Excel
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-filter me-2"></i>Filter Legacy Balances
            </h3>
        </div>
        <div class="card-body">
            <form method="get" asp-action="LegacyOutstandingFeesReport" class="row g-3">
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               id="searchTerm"
                               name="searchTerm"
                               value="@ViewBag.SearchTerm"
                               placeholder="Search student or application number" />
                        <label for="searchTerm">Search</label>
                        <div class="form-text">Student name or application number</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <select class="form-select" id="academicYear" name="academicYear">
                            <option value="">All Academic Years</option>
                            @if (academicYears != null)
                            {
                                foreach (var year in academicYears)
                                {
                                    <option value="@year" selected="@(ViewBag.AcademicYear == year)">
                                        @year
                                    </option>
                                }
                            }
                        </select>
                        <label for="academicYear">Academic Year</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="date"
                               class="form-control"
                               id="startDate"
                               name="startDate"
                               value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : "")" />
                        <label for="startDate">From Date</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="date"
                               class="form-control"
                               id="endDate"
                               name="endDate"
                               value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : "")" />
                        <label for="endDate">To Date</label>
                    </div>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i>Apply
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-list-ul me-2"></i>Legacy Outstanding List
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Application No.</th>
                        <th>Academic Year</th>
                        <th class="text-end">Amount (GHS)</th>
                        <th>Description</th>
                        <th>Date Added</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.Student?.Surname @item.Student?.OtherNames
                                </td>
                                <td>@item.Student?.ApplicationNumber</td>
                                <td>@item.AcademicYear</td>
                                <td class="text-end fw-bold">@item.Amount.ToString("N2")</td>
                                <td>@item.Description</td>
                                <td>
                                    @item.DateAdded?.ToString("dd MMM yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-2"></i>No legacy outstanding fees found.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               href="@Url.Action("LegacyOutstandingFeesReport", new {
                                         pageIndex = Model.PageIndex - 1,
                                         searchTerm = ViewBag.SearchTerm,
                                         academicYear = ViewBag.AcademicYear,
                                         startDate = ViewBag.StartDate,
                                         endDate = ViewBag.EndDate
                                     })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("LegacyOutstandingFeesReport", new {
                                             pageIndex = i,
                                             searchTerm = ViewBag.SearchTerm,
                                             academicYear = ViewBag.AcademicYear,
                                             startDate = ViewBag.StartDate,
                                             endDate = ViewBag.EndDate
                                         })">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               href="@Url.Action("LegacyOutstandingFeesReport", new {
                                         pageIndex = Model.PageIndex + 1,
                                         searchTerm = ViewBag.SearchTerm,
                                         academicYear = ViewBag.AcademicYear,
                                         startDate = ViewBag.StartDate,
                                         endDate = ViewBag.EndDate
                                     })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
</style>
