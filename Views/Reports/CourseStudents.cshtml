@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ApplicationClass.PaginatedList<PWCEPortal.Models.Academic.StudentCourseRegistration>

@{
    var course = ViewData["CourseInfo"] as Course;
    ViewData["Title"] = $"Students Registered for {course.CourseName}";
    Layout = "_AdminLayout";
    var getAcademicyear = await _Context.AcademicYears.Where(i => i.IsDeleted == false).ToListAsync();
}

<div class="container-fluid px-4">
    <div class="card border-0 shadow-lg rounded-lg">
        <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="fas fa-users me-3 fs-4"></i>
                <h4 class="mb-0">@course.CourseCode - @course.CourseName</h4>
            </div>
            <div class="stats-badge bg-light text-dark p-2 rounded">
                <i class="fas fa-user-graduate me-1"></i>
                <span class="fw-bold">@Model.TotalItems</span> students registered
            </div>
        </div>
        
        <div class="card-body p-4">
            <!-- Filter Panel -->
            <div class="control-panel bg-light p-4 rounded-3 mb-4">
                <form asp-action="CourseStudents" method="get" class="row g-3">
                    <input type="hidden" name="courseId" value="@course.Id" />
                    
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control border-start-0" 
                                   name="searchString" value="@ViewData["CurrentFilter"]"
                                   placeholder="Search students...">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <select class="form-select" name="academicYear" onchange="this.form.submit()">
                            <option value="">All Academic Years</option>
                            @if (ViewBag.AcademicYears != null)
                            {
                                foreach (var year in ViewBag.AcademicYears)
                                {
                                    <option value="@year" selected="@(year == ViewData["AcademicYearFilter"]?.ToString())">
                                        @year
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <select class="form-select" name="programFilter" onchange="this.form.submit()">
                            <option value="">All Programs</option>
                            @if (ViewBag.Programs != null)
                            {
                                foreach (var program in ViewBag.Programs)
                                {
                                    <option value="@program" selected="@(program == ViewData["ProgramFilter"]?.ToString())">
                                        @program
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-filter me-1"></i> Filter
                        </button>
                        <a asp-action="CourseStudents" asp-route-courseId="@course.Id" 
                           class="btn btn-outline-secondary">
                            <i class="fas fa-sync-alt"></i>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Students Table -->
            <div class="table-responsive rounded-3 border">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th class="ps-4">Application No</th>
                        <th class="ps-4">Student ID</th>
                        <th>Name</th>
                        <th>Level</th>
                        <th>Program</th>
                        <th>Academic Year</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        int count = Model.FirstItemOnPage;
                    }
                    @foreach (var registration in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td class="ps-4 fw-bold">@registration.Student.ApplicationNumber</td>
                            <td class="ps-4 fw-bold">@(registration.Student.StudentID??"N/A")</td>
                            <td>@registration.Student.Surname, @registration.Student.OtherNames</td>
                            <td>Level @registration.Student.CurrentLevel</td>
                            <td>@registration.Student.CollegeProgram?.ProgramName</td>
                            <td>@registration.Semester?.AcademicYear.Year</td>
                            <td class="text-end pe-4">
                                <a asp-controller="Student" asp-action="Details"
                                   asp-route-id="@registration.StudentId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i> View
                                </a>
                            </td>
                        </tr>
                        count++;
                    }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div class="text-muted">
                        Showing @Model.FirstItemOnPage to @Model.LastItemOnPage of @Model.TotalItems entries
                    </div>
                    
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a asp-action="CourseStudents"
                                   asp-route-courseId="@course.Id"
                                   asp-route-pageNumber="1"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   asp-route-academicYear="@ViewData["AcademicYearFilter"]"
                                   asp-route-programFilter="@ViewData["ProgramFilter"]"
                                   class="page-link" aria-label="First">
                                    <span aria-hidden="true">&laquo;&laquo;</span>
                                </a>
                            </li>
                            
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a asp-action="CourseStudents"
                                   asp-route-courseId="@course.Id"
                                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   asp-route-academicYear="@ViewData["AcademicYearFilter"]"
                                   asp-route-programFilter="@ViewData["ProgramFilter"]"
                                   class="page-link" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a asp-action="CourseStudents"
                                       asp-route-courseId="@course.Id"
                                       asp-route-pageNumber="@i"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       asp-route-academicYear="@ViewData["AcademicYearFilter"]"
                                       asp-route-programFilter="@ViewData["ProgramFilter"]"
                                       class="page-link">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a asp-action="CourseStudents"
                                   asp-route-courseId="@course.Id"
                                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   asp-route-academicYear="@ViewData["AcademicYearFilter"]"
                                   asp-route-programFilter="@ViewData["ProgramFilter"]"
                                   class="page-link" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                            
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a asp-action="CourseStudents"
                                   asp-route-courseId="@course.Id"
                                   asp-route-pageNumber="@Model.TotalPages"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   asp-route-academicYear="@ViewData["AcademicYearFilter"]"
                                   asp-route-programFilter="@ViewData["ProgramFilter"]"
                                   class="page-link" aria-label="Last">
                                    <span aria-hidden="true">&raquo;&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>


    <style>
        .card {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
            border: none;
        }
        
        .card-header {
            border-bottom: none;
        }
        
        .bg-gradient-primary {
            background: linear-gradient(135deg, #3f51b5 0%, #2196f3 100%);
        }
        
        .stats-badge {
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(33, 150, 243, 0.05) !important;
        }
        
        .control-panel {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05);
        }
        
        .pagination .page-item.active .page-link {
            background-color: #3f51b5;
            border-color: #3f51b5;
        }
        
        .pagination .page-link {
            color: #3f51b5;
        }
    </style>
