@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ApplicationClass.PaginatedList<PWCEPortal.ViewModel.Reports.CourseMetric>

@{
    ViewData["Title"] = "Course Enrollment Report";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="card border-0 shadow-lg rounded-lg">
        <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="fas fa-book me-3 fs-4"></i>
                <h4 class="mb-0">Course Enrollment Report</h4>
            </div>
            <div class="stats-badge bg-light text-dark p-2 rounded">
                <i class="fas fa-chart-bar me-1"></i>
                <span class="fw-bold">@ViewBag.TotalCourses</span> courses | 
                <span class="text-primary fw-bold">@Model.TotalItems</span> total enrollments
            </div>
        </div>
        
        <div class="card-body p-4">
            <!-- Search and Filter -->
            <div class="control-panel bg-light p-4 rounded-3 mb-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <form asp-action="NoStudentsByCourse" method="get">
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                                <input type="text" class="form-control border-start-0" 
                                       name="searchString" value="@ViewData["CurrentFilter"]"
                                       placeholder="Search courses...">
                                <button class="btn btn-primary" type="submit">Search</button>
                                <a asp-action="NoStudentsByCourse" class="btn btn-outline-secondary">
                                    <i class="fas fa-sync-alt"></i>
                                </a>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" 
                                    id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-sort me-1"></i> Sort By
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                                <li><a class="dropdown-item" href="#">Most Popular</a></li>
                                <li><a class="dropdown-item" href="#">Alphabetical</a></li>
                                <li><a class="dropdown-item" href="#">Fewest Students</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Courses Table -->
            <div class="table-responsive rounded-3 border">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Course Code</th>
                            <th>Course Name</th>
                            <th class="text-center">Enrollments</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@course.CourseCode</td>
                                <td>@course.CourseName</td>
                                <td class="text-center">
                                    <span class="custom-badge bg-primary rounded-pill">@course.TotalStudents</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Reports" asp-action="CourseStudents" asp-route-courseId="@course.CourseId" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-list me-1"></i> View Students
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div class="text-muted">
                        Showing @Model.FirstItemOnPage to @Model.LastItemOnPage of @Model.TotalItems entries
                    </div>
                    
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a asp-action="NoStudentsByCourse"
                                   asp-route-pageNumber="1"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="page-link" aria-label="First">
                                    <span aria-hidden="true">&laquo;&laquo;</span>
                                </a>
                            </li>
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a asp-action="NoStudentsByCourse"
                                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="page-link" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a asp-action="NoStudentsByCourse"
                                       asp-route-pageNumber="@i"
                                       asp-route-searchString="@ViewData["CurrentFilter"]"
                                       class="page-link">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a asp-action="NoStudentsByCourse"
                                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="page-link" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a asp-action="NoStudentsByCourse"
                                   asp-route-pageNumber="@Model.TotalPages"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   class="page-link" aria-label="Last">
                                    <span aria-hidden="true">&raquo;&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

    <style>
        .card {
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
            border: none;
        }
        
        .card-header {
            border-bottom: none;
        }
        
        .bg-gradient-primary {
            background: linear-gradient(135deg, #3f51b5 0%, #2196f3 100%);
        }
        
        .stats-badge {
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(33, 150, 243, 0.05) !important;
        }
        
        .badge {
            font-size: 0.85em;
            min-width: 2.5em;
            padding: 0.35em 0.65em;
        }
        
        .control-panel {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05);
        }
        
        .pagination .page-item.active .page-link {
            background-color: #3f51b5;
            border-color: #3f51b5;
        }
        
        .pagination .page-link {
            color: #3f51b5;
        }
    </style>
