@model PWCEPortal.Models.StudentInfo.Student
@{
    ViewBag.Title = "Generate Transcript";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Generate Transcript</h1>
    <p class="text-muted">@Model.Surname @Model.OtherNames &bull; @Model.StudentID</p>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white"><h5 class="mb-0">Request Transcript</h5></div>
        <div class="card-body">
            <p>Your transcript will be generated as a text document. For an official stamped transcript, please visit the Registrar's office.</p>
            <form asp-action="DownloadOwnTranscript" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Purpose (optional)</label>
                    <input name="purpose" class="form-control" placeholder="e.g., Job application, Further studies" />
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-download me-1"></i>Download Transcript</button>
            </form>
        </div>
    </div>
</div>
