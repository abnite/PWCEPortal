@model IEnumerable<PWCEPortal.Models.Academic.TranscriptRequest>
@{
    ViewBag.Title = "Transcript Log";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Transcript Generation Log</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student</th>
                            <th>Student ID</th>
                            <th>Type</th>
                            <th>Requested By</th>
                            <th>Purpose</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.Student?.Surname @r.Student?.OtherNames</td>
                                <td>@r.Student?.StudentID</td>
                                <td><span class="badge @(r.TranscriptType == PWCEPortal.Models.Academic.TranscriptType.Official ? "bg-primary" : "bg-secondary")">@r.TranscriptType</span></td>
                                <td>@r.RequestedBy?.LastName @r.RequestedBy?.FirstName</td>
                                <td>@r.Purpose</td>
                                <td>@r.RequestedAt.ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">No transcript requests yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
