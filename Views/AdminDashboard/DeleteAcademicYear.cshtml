@model PWCEPortal.Models.Academic.AcademicYear
@{
    ViewBag.Title = "Delete Academic Year";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Delete Academic Year</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("AcademicYears", "AdminDashboard")">Academic Years</a></li>
                <li class="breadcrumb-item active" aria-current="page">Delete</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
            </h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading"><i class="fas fa-exclamation-circle me-2"></i>Warning!</h4>
                <p>You are about to permanently delete the academic year <strong class="text-danger">@Model.Year</strong>. This action cannot be undone.</p>
                <hr>
                <p class="mb-0"><strong>Important:</strong> Deleting this academic year may affect associated records.</p>
            </div>

            <div class="card mb-4 border-warning">
                <div class="card-header bg-warning bg-opacity-10">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Year Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Academic Year:</dt>
                        <dd class="col-sm-9">@Model.Year</dd>

                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="custom-badge bg-success"><i class="fas fa-check-circle me-1"></i> Active</span>
                            }
                            else
                            {
                                <span class="custom-badge bg-secondary"><i class="fas fa-times-circle me-1"></i> Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Date Added:</dt>
                        <dd class="col-sm-9">@Model.DateAdded?.ToString("MMMM dd, yyyy")</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="DeleteAcademicYear" method="post" id="deleteForm">
                @Html.HiddenFor(model => model.Id)
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="@Url.Action("AcademicYears", "AdminDashboard")" class="btn btn-outline-secondary me-md-2">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger" id="deleteButton">
                        <i class="fas fa-trash-alt me-1"></i> Confirm Deletion
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('deleteButton').addEventListener('click', function(e) {
            e.preventDefault();
            
            Swal.fire({
                title: 'Are you absolutely sure?',
                text: "This will permanently delete the academic year '@Model.Year' and cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                focusCancel: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        });
    </script>
    
    <style>
        .card {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .border-danger {
            border-left: 4px solid #dc3545;
        }
        
        .border-warning {
            border-left: 4px solid #ffc107;
        }
        
        .breadcrumb {
            background-color: transparent;
            padding: 0;
            font-size: 0.9rem;
        }
        
        dt {
            font-weight: 500;
            color: #6c757d;
        }
        
        #deleteButton {
            transition: all 0.2s ease;
        }
        
        #deleteButton:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.25);
        }
    </style>
}