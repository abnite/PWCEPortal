@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ViewModel.Student.HallAndListViewModel

@{
    ViewBag.Title = "Hall Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Hall Management</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Halls</li>
            </ol>
        </nav>
    </div>

    <!-- Add New Hall Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Add New Hall</h3>
            <i class="fas fa-building fa-lg"></i>
        </div>
        <div class="card-body">
            <form asp-action="CollegeHalls" method="post">
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="form-floating">
                            <input asp-for="collegeHall.HallName" class="form-control" placeholder="Enter hall name" />
                            <label asp-for="collegeHall.HallName">Hall Name</label>
                            <span asp-validation-for="collegeHall.HallName" class="text-danger small"></span>
                            <div class="form-text">Enter the full name of the hall (e.g., "Main Auditorium")</div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <button type="reset" class="btn btn-outline-secondary me-md-2">
                        <i class="fas fa-undo me-1"></i> Clear
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-plus-circle me-1"></i> Add Hall
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Hall List Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">College Halls</h3>
            <div class="input-group" style="width: 300px;">
                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                <input type="text" id="searchInput" class="form-control" placeholder="Search halls...">
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="hallTable" class="table table-hover table-striped">
                    <thead class="table-light">
                    <tr>
                        <th width="5%">#</th>
                        <th width="30%">Hall Name</th>
                        <th width="25%">Added By</th>
                        <th width="20%">Date Added</th>
                        <th width="20%" class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.Halls != null && Model.Halls.Any())
                    {
                        var index = 1;
                        foreach (var hall in Model.Halls)
                        {
                            <tr>
                                <td>@index</td>
                                <td>
                                    <strong>@hall.HallName</strong>
                                    <!-- Optional: Display capacity if available -->
                                </td>
                                <td>@hall.AddedBy</td>
                                <td>@hall.DateAdded.Value.ToString("MMM dd, yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="EditUser" asp-route-userId="@hall.Id"
                                           class="btn btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="DeleteUser" asp-route-userId="@hall.Id"
                                           class="btn btn-outline-danger" title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this hall?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-building fa-2x mb-3"></i>
                                <p>No halls found. Add your first hall using the form above.</p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with search functionality
            $('#hallTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search halls..."
                },
                columnDefs: [
                    { orderable: false, targets: [4] } // Disable sorting on actions column
                ]
            });

            // Add focus style to form inputs
            $('.form-control').focus(function() {
                $(this).parent().addClass('input-focused');
            }).blur(function() {
                $(this).parent().removeClass('input-focused');
            });
        });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }

        .form-floating label {
            color: #6c757d;
        }

        .input-focused {
            transition: all 0.3s ease;
        }

        .input-focused label {
            color: #0d6efd !important;
        }

        .input-focused .form-control {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .btn-outline-primary:hover, .btn-outline-danger:hover {
            color: white;
        }

        .breadcrumb {
            background-color: transparent;
            padding: 0;
            font-size: 0.9rem;
        }

        .empty-state {
            opacity: 0.7;
        }
    </style>
}