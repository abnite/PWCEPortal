@model PWCEPortal.Models.Payment.PartPaymentConfig
@{
    ViewBag.Title = "Edit Part Payment Configuration";
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-header">
        <h3>Edit Part Payment Configuration</h3>
    </div>
    <div class="card-body">
        <form asp-action="EditPartPaymentConfig" method="post">
            @Html.HiddenFor(model => model.Id)
            <div class="mb-3">
               
                <input type="hidden" asp-for="AcademicYearId" class="form-control" required />
                <span asp-validation-for="AcademicYearId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PartPaymentPercentage" class="form-label">Part Payment Percentage (%)</label>
                <input asp-for="PartPaymentPercentage" type="number" class="form-control" required />
                <span asp-validation-for="PartPaymentPercentage" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
    </div>
</div>