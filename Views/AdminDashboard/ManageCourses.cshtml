@model IEnumerable<PWCEPortal.Models.Academic.Course>
@{
    ViewBag.Title = "Course Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Course Management</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("index", "AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Courses</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-book me-2"></i>Course Catalog
            </h3>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-4">
                <a class="btn btn-success" href="@Url.Action("CreateCourse", "AdminDashboard")">
                    <i class="fas fa-plus-circle me-2"></i>Create New Course
                </a>
            </div>

            <div class="table-responsive">
                <table id="coursesTable" class="table table-hover table-striped">
                    <thead class="table-light">
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Type</th>
                        <th>General Course</th>
                        <th>Program</th>
                        <th>Level</th>
                        <th>Semester</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>
                                <span class="custom-badge bg-primary">@course.CourseCode</span>
                            </td>
                            <td>@course.CourseName</td>
                            <td>
                                <span class="custom-badge @(course.CourseType == "Core" ? "bg-success" : "bg-info")">
                                    @course.CourseType
                                </span>
                            </td>
                            <td>
                                <span class="custom-badge @(course.IsCommon ? "bg-success" : "bg-secondary")">
                                    @(course.IsCommon ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                @(course.IsCommon
                                    ? "All Programmes"
                                    : course.CollegeProgram?.ProgramName)
                            </td>
                            <td>Level @course.Level</td>
                            <td>Semester @course.Semester</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-outline-primary" href="@Url.Action("EditCourse", "AdminDashboard", new { id = course.Id })" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a class="btn btn-outline-danger btn-delete"  href="@Url.Action("DeleteCourse", "AdminDashboard", new { id = course.Id })" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fas fa-book-open fa-2x mb-3"></i>
                                <p>No courses found. Create your first course.</p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this course?</p>
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone and may affect associated classes and students.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with search functionality
            $('#coursesTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search courses..."
                },
                columnDefs: [
                    { orderable: false, targets: [6] } // Disable sorting on actions column
                ]
            });

            // Delete confirmation modal
            $('.btn-delete').click(function() {
                var courseId = $(this).data('course-id');
                var deleteUrl = '@Url.Action("DeleteCourse", "AdminDashboard")/' + courseId;
                $('#deleteForm').attr('action', deleteUrl);
                $('#deleteModal').modal('show');
            });
        });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .btn-outline-primary:hover, .btn-outline-danger:hover {
            color: white;
        }

        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }

        .empty-state {
            opacity: 0.7;
        }

        .modal-header {
            border-bottom: none;
        }
    </style>
}