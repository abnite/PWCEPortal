@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ViewModel.Student.ClassAndListViewModel

@{
    ViewBag.Title = "Class Management";
    Layout = "_AdminLayout";
    var programs = await _Context.CollegePrograms.Where(i => i.IsDeleted == false).ToListAsync();
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Class Management</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Classes</li>
            </ol>
        </nav>
    </div>

    <!-- Add New Class Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Add New Class</h3>
            <i class="fas fa-plus-circle fa-lg"></i>
        </div>
        <div class="card-body">
            <form asp-action="CollegeClass" asp-controller="AdminDashboard" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="CollegeClass.ClassName" class="form-control" placeholder="Enter class name" />
                            <label asp-for="CollegeClass.ClassName">Class Name</label>
                            <span asp-validation-for="CollegeClass.ClassName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="CollegeClass.collegeProgramId" class="form-select">
                                <option value="">Select Program</option>
                                @foreach (var program in programs)
                                {
                                    <option value="@program.Id">@program.ProgramName</option>
                                }
                            </select>
                            <label asp-for="CollegeClass.collegeProgramId">Program</label>
                            <span asp-validation-for="CollegeClass.collegeProgramId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <button type="reset" class="btn btn-outline-secondary me-md-2">
                        <i class="fas fa-undo me-1"></i> Reset
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Add Class
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Class List Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Class List</h3>
            <div class="input-group" style="width: 300px;">
                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                <input type="text" id="searchInput" class="form-control" placeholder="Search classes...">
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="classTable" class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th width="5%">#</th>
                            <th width="20%">Class</th>
                            <th width="25%">Program</th>
                            <th width="15%">Added By</th>
                            <th width="15%">Date Added</th>
                            <th width="20%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Classes != null)
                        {
                            var index = 1;
                            foreach (var c in Model.Classes)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@c.ClassName</td>
                                    <td>@c.collegeProgram.ProgramName</td>
                                    <td>@c.AddedBy</td>
                                    <td>@c.DateAdded.Value.ToString("MMM dd, yyyy")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="EditUser" asp-route-userId="@c.Id" 
                                               class="btn btn-outline-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="DeleteUser" asp-route-userId="@c.Id" 
                                               class="btn btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete this class?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No classes found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with search functionality
            $('#classTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search classes..."
                }
            });
            
            // Add focus style to form inputs
            $('.form-control, .form-select').focus(function() {
                $(this).parent().addClass('input-focused');
            }).blur(function() {
                $(this).parent().removeClass('input-focused');
            });
        });
    </script>
    
    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .form-floating label {
            color: #6c757d;
        }
        
        .input-focused {
            transition: all 0.3s ease;
        }
        
        .input-focused label {
            color: #0d6efd !important;
        }
        
        .input-focused .form-control, .input-focused .form-select {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-outline-primary:hover, .btn-outline-danger:hover {
            color: white;
        }
        
        .breadcrumb {
            background-color: transparent;
            padding: 0;
        }
    </style>
}