@model PWCEPortal.ViewModel.Dashboard.AdminDashboardViewModel
@{
    ViewBag.Title = "Finance Dashboard";
    Layout = "_AdminLayout";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

<div class="container-fluid">
    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Admin Dashboard</h1>
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" id="quickActions" data-bs-toggle="dropdown" aria-expanded="false">
                Quick Actions
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="quickActions">
                <li>
                    <a class="dropdown-item" href="@Url.Action("PendingPayments", "FinanceDashboard")">
                        <i class="fas fa-check-circle me-2"></i>Verify Payments
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="@Url.Action("Index", "Students")">
                        <i class="fas fa-users me-2"></i>Manage Students
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="@Url.Action("AcademicYears", "Academic")">
                        <i class="fas fa-calendar-alt me-2"></i>Academic Years
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="@Url.Action("FeesCollected", "FinanceDashboard")">
                        <i class="fas fa-file-invoice-dollar me-2"></i>Fees Report
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row">
        <!-- Students Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Students
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalStudents</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fees Collected Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Fees Collected
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">GHS @Model.TotalFeesCollected.ToString("N2")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding Fees Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Outstanding Fees
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">GHS @Model.OutstandingFees.ToString("N2")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Verifications Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Pending Student Verifications
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PendingVerifications</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Academic Year -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="alert alert-info">
                <strong>Active Academic Year:</strong> @Model.ActiveAcademicYear
            </div>
        </div>
    </div>

    <!-- Content Row -->
    <div class="row">
        <!-- Fee Collection Chart -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Monthly Fee Collection</h6>
                    <div class="dropdown no-arrow">
                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in" aria-labelledby="dropdownMenuLink">
                            <div class="dropdown-header">Chart Options:</div>
                            <a class="dropdown-item" href="#" id="exportChart">Export as Image</a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="feeCollectionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Payments -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Payments</h6>
                </div>
                <div class="card-body">
                    <div class="activity-feed">
                        @foreach (var payment in Model.RecentPayments)
                        {
                            <div class="d-flex align-items-start mb-3">
                                <div class="icon-circle bg-success">
                                    <i class="fas fa-money-bill-wave text-white"></i>
                                </div>
                                <div class="ml-3">
                                    <div class="small text-gray-500">@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</div>
                                    <span class="font-weight-bold">@payment.Student.Surname @payment.Student.OtherNames</span>
                                    <div>GHS @payment.AmountPaid.ToString("N2")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Metrics -->
    <div class="row">
        <!-- Fee Breakdown by Level -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fee Breakdown by Level</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="levelPieChart"></canvas>
                    </div>
                    <div class="mt-4 text-center small">
                        @for (int i = 0; i < Model.LevelLabels.Count; i++)
                        {
                            <span class="mr-2">
                                <i class="fas fa-circle" style="color: @GetChartColor(i)"></i> @Model.LevelLabels[i]
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Reports -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Reports</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("FeesCollected", "FinanceDashboard")" class="btn btn-block btn-info">
                                <i class="fas fa-file-excel mr-2"></i> Export Fees Collected
                            </a>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("OutstandingFees", "FinanceDashboard")" class="btn btn-block btn-warning">
                                <i class="fas fa-file-excel mr-2"></i> Export Outstanding Fees
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <!-- Card Header -->
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
        </div>

        <!-- Card Body -->
        <div class="card-body">
            <div class="row">
                <!-- Verify Payments -->
                <div class="col-md-6 col-lg-3 mb-3">
                    <a href="@Url.Action("PendingPayments", "FinanceDashboard")" class="btn btn-block btn-primary h-100 py-3">
                        <div class="d-flex flex-column align-items-center">
                            <i class="fas fa-check-circle fa-2x mb-2"></i>
                            <span>Verify Payments</span>
                        </div>
                    </a>
                </div>

                <!-- Manage Students -->
                <div class="col-md-6 col-lg-3 mb-3">
                    <a href="@Url.Action("Index", "Student")" class="btn btn-block btn-success h-100 py-3">
                        <div class="d-flex flex-column align-items-center">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <span>Manage Students</span>
                        </div>
                    </a>
                </div>

                <!-- Academic Years -->
                <div class="col-md-6 col-lg-3 mb-3">
                    <a href="@Url.Action("AcademicYears", "AdminDashboard")" class="btn btn-block btn-info h-100 py-3">
                        <div class="d-flex flex-column align-items-center">
                            <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                            <span>Academic Years</span>
                        </div>
                    </a>
                </div>

                <!-- Generate Reports -->
                <div class="col-md-6 col-lg-3 mb-3">
                    <a href="@Url.Action("FeesCollected", "FinanceDashboard")" class="btn btn-block btn-warning h-100 py-3">
                        <div class="d-flex flex-column align-items-center">
                            <i class="fas fa-file-invoice-dollar fa-2x mb-2"></i>
                            <span>Generate Reports</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetChartColor(int index)
    {
        string[] colors = { "#4e73df", "#1cc88a", "#36b9cc", "#f6c23e", "#e74a3b" };
        return colors[index % colors.Length];
    }
}


    <style>
        .icon-circle {
            height: 2.5rem;
            width: 2.5rem;
            border-radius: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            transition: transform 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

        .activity-feed {
            max-height: 350px;
            overflow-y: auto;
        }
    </style>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Fee Collection Line Chart with REAL DATA
        var ctx = document.getElementById('feeCollectionChart').getContext('2d');
        var feeChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MonthlyPaymentLabels)),
                datasets: [{
                    label: 'Fees Collected (GHS)',
                    data: @Html.Raw(Json.Serialize(Model.MonthlyPaymentData)),
                    backgroundColor: 'rgba(78, 115, 223, 0.05)',
                    borderColor: 'rgba(78, 115, 223, 1)',
                    pointBackgroundColor: 'rgba(78, 115, 223, 1)',
                    pointBorderColor: '#fff',
                    pointHoverBackgroundColor: '#fff',
                    pointHoverBorderColor: 'rgba(78, 115, 223, 1)',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    borderWidth: 2,
                    fill: true
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: "rgb(255,255,255)",
                        bodyFontColor: "#858796",
                        titleMarginBottom: 10,
                        titleFontColor: '#6e707e',
                        titleFontSize: 14,
                        borderColor: '#dddfeb',
                        borderWidth: 1,
                        xPadding: 15,
                        yPadding: 15,
                        displayColors: false,
                        intersect: false,
                        mode: 'index',
                        caretPadding: 10,
                        callbacks: {
                            label: function(context) {
                                return 'GHS ' + context.parsed.y.toLocaleString('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#858796'
                        }
                    },
                    y: {
                        ticks: {
                            color: '#858796',
                            callback: function(value) {
                                return 'GHS ' + value.toLocaleString('en-US', {
                                    minimumFractionDigits: 0,
                                    maximumFractionDigits: 0
                                });
                            }
                        },
                        grid: {
                            color: "rgb(234, 236, 244)",
                            zeroLineColor: "rgb(234, 236, 244)",
                            drawBorder: false,
                            borderDash: [2],
                            zeroLineBorderDash: [2]
                        }
                    }
                }
            }
        });

        // Level Pie Chart with REAL DATA
        var ctx2 = document.getElementById('levelPieChart');
        var levelPieChart = new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.LevelLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.LevelData)),
                    backgroundColor: [
                        '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'
                    ],
                    hoverBackgroundColor: [
                        '#2e59d9', '#17a673', '#2c9faf', '#dda20a', '#be2617'
                    ],
                    hoverBorderColor: "rgba(234, 236, 244, 1)",
                }],
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    tooltip: {
                        backgroundColor: "rgb(255,255,255)",
                        bodyFontColor: "#858796",
                        borderColor: '#dddfeb',
                        borderWidth: 1,
                        xPadding: 15,
                        yPadding: 15,
                        displayColors: false,
                        caretPadding: 10,
                        callbacks: {
                            label: function(context) {
                                return context.label + ': GHS ' + context.raw.toLocaleString('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                        }
                    },
                    legend: {
                        display: false
                    }
                },
                cutout: '80%',
            },
        });

        // Export Chart as Image
        document.getElementById('exportChart').addEventListener('click', function() {
            var canvas = document.getElementById('feeCollectionChart');
            var dataURL = canvas.toDataURL('image/png');
            var link = document.createElement('a');
            link.download = 'fee-collection-chart.png';
            link.href = dataURL;
            link.click();
        });
    </script>
}