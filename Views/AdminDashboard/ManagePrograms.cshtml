@model IEnumerable<PWCEPortal.Models.Academic.CollegeProgram>
@{
    ViewBag.Title = "Program Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Program Management</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="AdminDashboard">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Programs</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-graduation-cap me-2"></i>Academic Programs
            </h3>
            <div class="input-group" style="width: 300px;">
                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                <input type="text" id="searchInput" class="form-control" placeholder="Search programs...">
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-4">
                <a class="btn btn-success" href="@Url.Action("CreateProgram", "AdminDashboard")">
                    <i class="fas fa-plus-circle me-2"></i>Create New Program
                </a>
            </div>

            <div class="table-responsive">
                <table id="programsTable" class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th width="70%">Program Name</th>
                            <th width="30%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var program in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@program.ProgramName</strong>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-primary" href="@Url.Action("EditProgram", "AdminDashboard", new { id = program.Id })" title="Edit">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <button class="btn btn-outline-danger btn-delete" data-program-id="@program.Id" title="Delete">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-4">
                                    <i class="fas fa-graduation-cap fa-2x mb-3"></i>
                                    <p>No programs found. Create your first program.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this program?</p>
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone and may affect associated courses and students.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable while preserving server-side sorting
            $('#programsTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search programs..."
                },
                columnDefs: [
                    { orderable: false, targets: [1] } // Disable sorting on actions column
                ],
                order: [], // Disable initial sorting to respect controller ordering
                paging: true,
                pageLength: 10
            });
            
            // Delete confirmation modal
            $('.btn-delete').click(function() {
                var programId = $(this).data('program-id');
                var deleteUrl = '@Url.Action("DeleteProgram", "AdminDashboard")/' + programId;
                $('#deleteForm').attr('action', deleteUrl);
                $('#deleteModal').modal('show');
            });
        });
    </script>
    
    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-outline-primary:hover, .btn-outline-danger:hover {
            color: white;
        }
        
        .breadcrumb {
            background-color: transparent;
            padding: 0;
            font-size: 0.9rem;
        }
        
        .empty-state {
            opacity: 0.7;
        }
        
        .modal-header {
            border-bottom: none;
        }
    </style>
}