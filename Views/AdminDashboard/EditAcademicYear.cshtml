@model PWCEPortal.Models.Academic.AcademicYear
@{
    ViewBag.Title = "Edit Academic Year";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Edit Academic Year</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("AcademicYears", "AdminDashboard")">Academic Years</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-calendar-edit me-2"></i>Edit Academic Year
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="EditAcademicYear" method="post" class="needs-validation" novalidate>
                @Html.HiddenFor(model => model.Id)
                <input asp-for="Id" type="hidden" value="@Model.Id" />
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-4">
                            <input asp-for="Year" class="form-control" placeholder="Enter academic year" required />
                            <label asp-for="Year">Academic Year</label>
                            <span asp-validation-for="Year" class="text-danger small"></span>
                            <div class="form-text">Format: YYYY/YYYY (e.g., 2023/2024)</div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckActive" />
                            <label class="form-check-label" for="flexSwitchCheckActive">
                                Active Academic Year
                            </label>
                            <div class="form-text">Only one academic year can be active at a time</div>
                        </div>
                    </div>
                </div>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a href="@Url.Action("AcademicYears", "AdminDashboard")" class="btn btn-outline-secondary me-md-2">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side validation
        (function () {
            'use strict'
            
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation')
            
            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
        
        // Toggle switch visual feedback
        document.getElementById('flexSwitchCheckActive').addEventListener('change', function() {
            if(this.checked) {
                if(!confirm('Setting this as active year will deactivate any currently active year. Continue?')) {
                    this.checked = false;
                }
            }
        });
    </script>
    
    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .form-floating label {
            color: #6c757d;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }
        
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .form-switch .form-check-input {
            width: 3em;
            height: 1.5em;
        }
        
        .breadcrumb {
            background-color: transparent;
            padding: 0;
            font-size: 0.9rem;
        }
    </style>
}