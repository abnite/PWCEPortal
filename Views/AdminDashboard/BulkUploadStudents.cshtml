@{
    ViewBag.Title = "Bulk Upload Students";
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-header">
        <h3>Bulk Upload Student Records</h3>
    </div>
    <div class="card-body">
        <form asp-action="BulkUploadStudents" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="file" class="form-label">Select Excel file:</label>
                <input type="file" name="file" id="file" class="form-control" accept=".xlsx" required />
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
        </form>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["ErrorMessage"]
            </div>
        }
    </div>
</div>
