@model IEnumerable<AcademicYear>
@{
    ViewBag.Title = "Academic Year Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Academic Year Management</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Academic Years</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-calendar-alt me-2"></i>Academic Years
            </h3>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between mb-4">
                <div class="btn-group">
                    <a class="btn btn-success" href="@Url.Action("CreateAcademicYear", "AdminDashboard")">
                        <i class="fas fa-plus-circle me-2"></i>Create New Academic Year
                    </a>
                    <a class="btn btn-primary ms-2" href="@Url.Action("GenerateFeeAssignmentsForActiveYear", "AdminDashboard")">
                        <i class="fas fa-money-bill-wave me-2"></i>Assign Fees for Active Year
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table id="academicYearTable" class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th width="30%">Academic Year</th>
                            <th width="15%">Status</th>
                            <th width="25%">Date Added</th>
                            <th width="30%" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var year in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@year.Year</strong>
                                    @if (year.IsActive)
                                    {
                                        <span class="custom-badge bg-success ms-2">Current</span>
                                    }
                                </td>
                                <td>
                                    @if (year.IsActive)
                                    {
                                        <span class="custom-badge bg-success"><i class="fas fa-check-circle me-1"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge bg-secondary"><i class="fas fa-times-circle me-1"></i> Inactive</span>
                                    }
                                </td>
                                <td>@year.DateAdded?.ToString("MMMM dd, yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a class="btn btn-outline-primary" href="@Url.Action("EditAcademicYear", "AdminDashboard", new { id = year.Id })" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-outline-danger btn-delete" data-year-id="@year.Id" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="fas fa-calendar-alt fa-2x mb-3"></i>
                                    <p>No academic years found. Create your first academic year.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this academic year?</p>
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Warning:</strong> This action cannot be undone and may affect associated records.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with search functionality
            $('#academicYearTable').DataTable({
                responsive: true,
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search academic years..."
                },
                columnDefs: [
                    { orderable: false, targets: [3] } // Disable sorting on actions column
                ],
                order: [], // Disable initial sorting to respect controller ordering
                paging: true,
                pageLength: 10
            });
            
            // Delete confirmation modal
            $('.btn-delete').click(function() {
                var yearId = $(this).data('year-id');
                var deleteUrl = '@Url.Action("DeleteAcademicYear", "AdminDashboard")/' + yearId;
                $('#deleteForm').attr('action', deleteUrl);
                $('#deleteModal').modal('show');
            });
        });
    </script>
    
    <style>
        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        
        .card-header {
            border-bottom: none;
            padding: 1.25rem 1.5rem;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-outline-primary:hover, .btn-outline-danger:hover {
            color: white;
        }
        
        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
        
        .empty-state {
            opacity: 0.7;
        }
        
        .modal-header {
            border-bottom: none;
        }
    </style>
}