@model PWCEPortal.ViewModel.Permissions.RolePermissionsViewModel
@{
    ViewBag.Title = "Edit Role Permissions";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Edit Permissions — <span class="text-primary">@Model.RoleName</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("index", "AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Permissions")">Permissions</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.RoleName</li>
            </ol>
        </nav>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="alert alert-info mb-3">
            <i class="fas fa-info-circle me-2"></i><strong>Role:</strong> @Model.Description
        </div>
    }

    <form asp-action="Edit" asp-controller="Permissions" asp-route-roleName="@Model.RoleName"
          method="post">
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <button type="button" class="btn btn-outline-secondary btn-sm me-2" id="selectAll">
                    <i class="fas fa-check-double me-1"></i>Select All
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="clearAll">
                    <i class="fas fa-times me-1"></i>Clear All
                </button>
            </div>
            <div>
                <a href="@Url.Action("Index", "Permissions")" class="btn btn-secondary me-2">
                    <i class="fas fa-arrow-left me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Save Permissions
                </button>
            </div>
        </div>

        @foreach (var group in Model.PermissionGroups)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0">
                        <i class="fas fa-layer-group me-2 text-primary"></i>@group.GroupName
                    </h6>
                    <span class="badge bg-primary">
                        @group.Permissions.Count(p => p.IsGranted) / @group.Permissions.Count
                    </span>
                </div>
                <div class="card-body py-2">
                    <div class="row">
                        @foreach (var permission in group.Permissions)
                        {
                            <div class="col-lg-4 col-md-6 py-1">
                                <div class="form-check">
                                    <input class="form-check-input permission-checkbox"
                                           type="checkbox"
                                           name="SelectedPermissions"
                                           value="@permission.Value"
                                           id="perm_@permission.Value.Replace('.', '_')"
                                           @(permission.IsGranted ? "checked" : "") />
                                    <label class="form-check-label small"
                                           for="perm_@permission.Value.Replace('.', '_')">
                                        @permission.DisplayName
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end mt-3">
            <a href="@Url.Action("Index", "Permissions")" class="btn btn-secondary me-2">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Save Permissions
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('selectAll').addEventListener('click', function () {
            document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = true);
        });

        document.getElementById('clearAll').addEventListener('click', function () {
            document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = false);
        });
    </script>
}
