@model IEnumerable<PWCEPortal.Models.Staff.NonTeachingAppraisal>
@{
    ViewBag.Title = "Non-Teaching Staff Appraisals";
    Layout = "_AdminLayout";
    var staffList = ViewBag.StaffList as IEnumerable<PWCEPortal.Models.Staff.NonTeachingStaff>;
    var years = ViewBag.AcademicYears as IEnumerable<PWCEPortal.Models.Academic.AcademicYear>;
    var selectedStaffId = ViewBag.SelectedStaffId as Guid?;
    var selectedYearId = ViewBag.SelectedYearId as Guid?;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Non-Teaching Staff Appraisals</h1>
    </div>

    <div class="row mb-3">
        <div class="col-md-8">
            <form method="get" class="d-flex gap-2">
                <select name="staffId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Staff --</option>
                    @foreach (var s in staffList!)
                    {
                        <option value="@s.Id" selected="@(s.Id == selectedStaffId)">@s.FullName (@s.StaffId)</option>
                    }
                </select>
                <select name="academicYearId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Years --</option>
                    @foreach (var y in years!)
                    {
                        <option value="@y.Id" selected="@(y.Id == selectedYearId)">@y.Year</option>
                    }
                </select>
            </form>
        </div>
        <div class="col-md-auto ms-auto">
            @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.Appraise"))
            {
                <a asp-action="StartAppraisal" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Appraisal</a>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr><th>Staff</th><th>Template</th><th>Year</th><th>Conducted By</th><th>Score</th><th>Status</th><th class="text-center">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><strong>@a.NonTeachingStaff?.FullName</strong></td>
                                <td>@a.AppraisalTemplate?.TemplateName</td>
                                <td>@a.AcademicYear?.Year</td>
                                <td>@a.ConductedBy?.LastName @a.ConductedBy?.FirstName</td>
                                <td>@(a.TotalScore.HasValue ? $"{a.TotalScore}/{a.MaxPossibleScore}" : "—")</td>
                                <td><span class="custom-badge @(a.Status == PWCEPortal.Models.Staff.AppraisalStatus.Completed ? "bg-success" : "bg-warning text-dark")">@a.Status</span></td>
                                <td class="text-center">
                                    <a asp-action="ConductAppraisal" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-@(a.Status == PWCEPortal.Models.Staff.AppraisalStatus.InProgress ? "edit" : "eye")"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted">No appraisals found.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
