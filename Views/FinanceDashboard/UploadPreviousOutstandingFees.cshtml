@{
    ViewBag.Title = "Upload Previous Outstanding Fees";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Upload Previous Outstanding Fees</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "AdminDashboard")">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Legacy Outstanding Fees</li>
            </ol>
        </nav>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-file-upload me-2"></i>Upload Excel File
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="UploadPreviousOutstandingFees" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="excelFile" class="form-label fw-semibold">Select Excel File (.xlsx, .xls)</label>
                            <input type="file" class="form-control" id="excelFile" name="excelFile" accept=".xlsx,.xls" required />
                            <div class="form-text">
                                The file should follow the template format. You can download the template on the right.
                            </div>
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-upload me-1"></i> Upload & Process
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @if (ViewBag.Errors != null && ((List<string>)ViewBag.Errors).Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-circle me-2"></i>Upload Issues
                        </h5>
                    </div>
                    <div class="card-body">
                        <p>The following rows could not be imported:</p>
                        <ul class="list-group">
                            @foreach (var err in (List<string>)ViewBag.Errors)
                            {
                                <li class="list-group-item">
                                    <i class="fas fa-times-circle text-danger me-2"></i>@err
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Instructions
                    </h5>
                </div>
                <div class="card-body">
                    <p>Prepare your Excel file with the following columns:</p>
                    <ol>
                        <li><strong>ApplicationNumber</strong> (required)</li>
                        <li><strong>AcademicYear</strong> (optional, e.g., 2022/2023)</li>
                        <li><strong>OutstandingAmount</strong> (required, numeric)</li>
                        <li><strong>Description</strong> (optional)</li>
                    </ol>

                    <p class="mb-2">
                        Each row represents one outstanding balance entry for a student.
                    </p>
                    <p class="mb-2">
                        When uploaded, the amount is added to the student's
                        <strong>OutstandingFees</strong> and also logged as a
                        <strong>LegacyOutstandingFee</strong> record.
                    </p>

                    <a asp-action="DownloadPreviousOutstandingTemplate" class="btn btn-outline-primary w-100 mt-3">
                        <i class="fas fa-download me-1"></i> Download Template
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
</style>
