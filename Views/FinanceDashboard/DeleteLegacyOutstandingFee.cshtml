@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.Models.Payment.LegacyOutstandingFee

@{
    ViewData["Title"] = "Delete Legacy Outstanding Fee";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Legacy Outstanding Fee</h4>
        </div>
        
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                Are you sure you want to delete this legacy outstanding fee? This action cannot be undone.
            </div>

            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 40%">Student Application #</th>
                            <td>@Model.Student?.ApplicationNumber</td>
                        </tr>
                        <tr>
                            <th>Academic Year</th>
                            <td>@(string.IsNullOrEmpty(Model.AcademicYear) ? "N/A" : Model.AcademicYear)</td>
                        </tr>
                        <tr>
                            <th>Amount</th>
                            <td class="fw-bold text-danger">@Model.Amount.ToString("C")</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>@Model.Description</td>
                        </tr>
                        <tr>
                            <th>Date Added</th>
                            <td>@(Model.DateAdded?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Added By</th>
                            <td>@Model.AddedBy</td>
                        </tr>
                    </table>
                </div>
            </div>

            <form asp-action="DeleteLegacyOutstandingFeeConfirmed" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="mt-3">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="LegacyOutstandingFeesList" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>