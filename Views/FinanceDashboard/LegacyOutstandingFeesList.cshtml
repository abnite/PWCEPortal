@model PWCEPortal.ApplicationClass.PaginatedList<PWCEPortal.Models.Payment.LegacyOutstandingFee>

@{
    ViewBag.Title = "Manage Legacy Outstanding Fees";
    Layout = "_AdminLayout";
    var academicYears = ViewBag.AcademicYears as List<string>;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Manage Legacy Outstanding Fees</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("LegacyOutstandingFeesReport", "YourControllerName")">Legacy Report</a></li>
                <li class="breadcrumb-item active" aria-current="page">Manage Legacy</li>
            </ol>
        </nav>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="fas fa-exclamation-triangle me-2"></i>Total Legacy Outstanding
                </div>
                <div class="card-body">
                    <h3 class="card-title text-danger">
                        GHS @(((decimal)ViewBag.TotalLegacyOutstanding).ToString("N2"))
                    </h3>
                    <p class="card-text">Total of all imported previous balances.</p>
                </div>
            </div>
        </div>
        <div class="col-md-8 text-md-end mt-3 mt-md-0">
            <a asp-action="UploadPreviousOutstandingFees" 
               class="btn btn-primary me-2">
                <i class="fas fa-upload me-1"></i> Upload New
            </a>
            <a asp-action="DownloadPreviousOutstandingTemplate" 
               class="btn btn-info text-white me-2">
                <i class="fas fa-download me-1"></i> Download Template
            </a>
            <a asp-action="LegacyOutstandingFeesReport" 
               class="btn btn-outline-secondary">
                <i class="fas fa-chart-bar me-1"></i> View Report
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Filter Legacy Fees
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="LegacyOutstandingFeesList" class="row g-3">
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               id="searchString"
                               name="searchString"
                               value="@ViewBag.CurrentFilter"
                               placeholder="Search student or application number" />
                        <label for="searchString">Search</label>
                        <div class="form-text">Student name or application number</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <select class="form-select" id="academicYear" name="academicYear">
                            <option value="">All Academic Years</option>
                            @if (academicYears != null)
                            {
                                foreach (var year in academicYears)
                                {
                                    <option value="@year" selected="@(ViewBag.AcademicYear == year)">
                                        @year
                                    </option>
                                }
                            }
                        </select>
                        <label for="academicYear">Academic Year</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="date"
                               class="form-control"
                               id="startDate"
                               name="startDate"
                               value="@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd") : "")" />
                        <label for="startDate">From Date</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="date"
                               class="form-control"
                               id="endDate"
                               name="endDate"
                               value="@(ViewBag.EndDate != null ? ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd") : "")" />
                        <label for="endDate">To Date</label>
                    </div>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i>Apply Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Legacy Fees List Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>Legacy Outstanding Fees List
            </h5>
            <span class="custom-badge bg-secondary">Total Records: @Model.Count</span>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Application No.</th>
                                <th>Academic Year</th>
                                <th class="text-end">Amount (GHS)</th>
                                <th>Description</th>
                                <th>Date Added</th>
                                <th>Added By</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Student?.Surname @item.Student?.OtherNames</strong>
                                    </td>
                                    <td>
                                        <span class="custom-badge bg-info">@item.Student?.ApplicationNumber</span>
                                    </td>
                                    <td>@(item.AcademicYear ?? "N/A")</td>
                                    <td class="text-end fw-bold text-danger">@item.Amount.ToString("N2")</td>
                                    <td>
                                        <span title="@item.Description">
                                            @(item.Description?.Length > 30 ? item.Description.Substring(0, 30) + "..." : item.Description)
                                        </span>
                                    </td>
                                    <td>@item.DateAdded?.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        <span class="custom-badge bg-secondary">@item.AddedBy.FirstName @item.AddedBy.LastName</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="DeleteLegacyOutstandingFee" 
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm"
                                           title="Delete this legacy fee">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link"
                                   href="@Url.Action("LegacyOutstandingFeesList", new {
                                             pageIndex = Model.PageIndex - 1,
                                             searchString = ViewBag.CurrentFilter,
                                             academicYear = ViewBag.AcademicYear,
                                             startDate = ViewBag.StartDate,
                                             endDate = ViewBag.EndDate
                                         })">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            </li>
                            
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("LegacyOutstandingFeesList", new {
                                                 pageIndex = i,
                                                 searchString = ViewBag.CurrentFilter,
                                                 academicYear = ViewBag.AcademicYear,
                                                 startDate = ViewBag.StartDate,
                                                 endDate = ViewBag.EndDate
                                             })">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link"
                                   href="@Url.Action("LegacyOutstandingFeesList", new {
                                             pageIndex = Model.PageIndex + 1,
                                             searchString = ViewBag.CurrentFilter,
                                             academicYear = ViewBag.AcademicYear,
                                             startDate = ViewBag.StartDate,
                                             endDate = ViewBag.EndDate
                                         })">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-4x mb-3"></i>
                    <h5>No legacy outstanding fees found</h5>
                    <p class="mb-3">Try adjusting your filters or upload new legacy fees.</p>
                    <a asp-action="UploadPreviousOutstandingFees" class="btn btn-primary">
                        <i class="fas fa-upload me-2"></i>Upload Legacy Fees
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal (Optional - can be used instead of separate page) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this legacy outstanding fee?</p>
                <p class="text-danger fw-bold mb-0">This action cannot be undone and will update the student's outstanding balance.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form id="deleteForm" method="post" asp-action="DeleteLegacyOutstandingFeeConfirmed">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" value="" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Optional: If you want to use modal instead of separate page
        function confirmDelete(id) {
            document.getElementById('deleteId').value = id;
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }
    </script>
}

<style>
    .card {
        border-radius: 10px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    
    .badge12 {
        font-weight: 500;
    }
    
    .table > :not(caption) > * > * {
        padding: 1rem 0.75rem;
    }
    
    .btn-outline-secondary:hover i {
        color: white;
    }
    
    .alert {
        border-radius: 10px;
    }
</style>