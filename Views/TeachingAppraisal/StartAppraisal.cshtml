@model PWCEPortal.ViewModel.Appraisal.StartAppraisalViewModel
@{
    ViewBag.Title = "Start Appraisal";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Start Teaching Appraisal</h1>
    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <form asp-action="StartAppraisal" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="TemplateId" class="form-label">Appraisal Template</label>
                        <select asp-for="TemplateId" class="form-select" required>
                            <option value="">-- Select Template --</option>
                            @foreach (var t in Model.Templates)
                            {
                                <option value="@t.Id">@t.TemplateName</option>
                            }
                        </select>
                        <span asp-validation-for="TemplateId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LecturerId" class="form-label">Lecturer</label>
                        <select asp-for="LecturerId" class="form-select select2" required>
                            <option value="">-- Select Lecturer --</option>
                            @foreach (var l in Model.Lecturers)
                            {
                                <option value="@l.Id">@l.User?.LastName @l.User?.FirstName (@l.StaffId)</option>
                            }
                        </select>
                        <span asp-validation-for="LecturerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="AcademicYearId" class="form-label">Academic Year</label>
                        <select asp-for="AcademicYearId" class="form-select" required>
                            <option value="">-- Select Year --</option>
                            @foreach (var y in Model.AcademicYears)
                            {
                                <option value="@y.Id">@y.Year</option>
                            }
                        </select>
                        <span asp-validation-for="AcademicYearId" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-play me-1"></i>Start</button>
                </div>
            </form>
        </div>
    </div>
</div>
