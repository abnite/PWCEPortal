@model IEnumerable<PWCEPortal.Models.Staff.TeachingAppraisal>
@{
    ViewBag.Title = "My Appraisals";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">My Appraisals</h1>
    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr><th>Template</th><th>Academic Year</th><th>Conducted By</th><th>Score</th><th>Status</th><th>Remarks</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.AppraisalTemplate?.TemplateName</td>
                                <td>@a.AcademicYear?.Year</td>
                                <td>@a.ConductedBy?.LastName @a.ConductedBy?.FirstName</td>
                                <td>@(a.TotalScore.HasValue ? $"{a.TotalScore} / {a.MaxPossibleScore}" : "—")</td>
                                <td><span class="custom-badge @(a.Status == PWCEPortal.Models.Staff.AppraisalStatus.Completed ? "bg-success" : "bg-warning text-dark")">@a.Status</span></td>
                                <td>@a.OverallRemarks</td>
                            </tr>
                        }
                        @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted">No appraisals found.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
