@model PWCEPortal.ViewModel.Appraisal.AppraisalTemplateViewModel
@{
    ViewBag.Title = "Edit Appraisal Template";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Appraisal Template</h1>
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-warning"><h5 class="mb-0">Edit Template</h5></div>
        <div class="card-body">
            <form asp-action="EditTemplate" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="TemplateName" class="form-label"></label>
                        <input asp-for="TemplateName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>

                <h5>Criteria</h5>
                <div id="criteriaList">
                    @for (int i = 0; i < Model.Criteria.Count; i++)
                    {
                        <div class="row g-2 mb-2 criterion-row">
                            <input type="hidden" name="Criteria[@i].DisplayOrder" value="@(i+1)" />
                            <div class="col-md-5"><input name="Criteria[@i].CriterionName" class="form-control" value="@Model.Criteria[i].CriterionName" required /></div>
                            <div class="col-md-3"><input name="Criteria[@i].Description" class="form-control" value="@Model.Criteria[i].Description" placeholder="Description" /></div>
                            <div class="col-md-2"><div class="input-group"><input name="Criteria[@i].MaxScore" type="number" step="0.01" min="1" class="form-control" value="@Model.Criteria[i].MaxScore" required /><span class="input-group-text">pts</span></div></div>
                            <div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-criterion"><i class="fas fa-minus"></i></button></div>
                        </div>
                    }
                </div>
                <button type="button" id="addCriterion" class="btn btn-outline-success btn-sm mb-3">
                    <i class="fas fa-plus me-1"></i>Add Criterion
                </button>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Templates" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning">Update Template</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let idx = @Model.Criteria.Count;
    document.getElementById('addCriterion').addEventListener('click', function () {
        const row = `<div class="row g-2 mb-2 criterion-row">
            <input type="hidden" name="Criteria[${idx}].DisplayOrder" value="${idx+1}" />
            <div class="col-md-5"><input name="Criteria[${idx}].CriterionName" class="form-control" placeholder="Criterion name" required /></div>
            <div class="col-md-3"><input name="Criteria[${idx}].Description" class="form-control" placeholder="Description" /></div>
            <div class="col-md-2"><div class="input-group"><input name="Criteria[${idx}].MaxScore" type="number" step="0.01" min="1" class="form-control" placeholder="Max" required /><span class="input-group-text">pts</span></div></div>
            <div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-criterion"><i class="fas fa-minus"></i></button></div>
        </div>`;
        document.getElementById('criteriaList').insertAdjacentHTML('beforeend', row);
        idx++;
        bindRemove();
    });
    function bindRemove() {
        document.querySelectorAll('.remove-criterion').forEach(b => { b.onclick = function() { this.closest('.criterion-row').remove(); }; });
    }
    bindRemove();
</script>
}
