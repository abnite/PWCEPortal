@using PWCEPortal.Models.Staff
@{
    var session = (TeachingAppraisalSession)ViewBag.Session;
    var submissions = (List<StudentAppraisalSubmission>)ViewBag.Submissions;
    var criteria = (List<AppraisalCriterion>)ViewBag.Criteria;
    var averages = (Dictionary<Guid, decimal>)ViewBag.Averages;
    ViewBag.Title = "Session Results";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Session Results</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Sessions" asp-controller="TeachingAppraisal">Sessions</a></li>
                <li class="breadcrumb-item active">Results</li>
            </ol>
        </nav>
    </div>

    <!-- Session Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <strong>Course:</strong><br />
                    @session.Assignment?.Course?.CourseName
                </div>
                <div class="col-md-3">
                    <strong>Lecturer:</strong><br />
                    @(session.Assignment?.Lecturer?.User?.FirstName + " " + session.Assignment?.Lecturer?.User?.LastName)
                </div>
                <div class="col-md-3">
                    <strong>Template:</strong><br />
                    @session.AppraisalTemplate?.TemplateName
                </div>
                <div class="col-md-3">
                    <strong>Status:</strong><br />
                    @if (session.IsOpen)
                    {
                        <span class="badge bg-success">Open (@submissions.Count responses so far)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Closed — @submissions.Count total responses</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!submissions.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No submissions yet. The session is @(session.IsOpen ? "open" : "closed").
        </div>
    }
    else
    {
        <!-- Average scores per criterion -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Average Scores by Criterion</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Criterion</th>
                            <th class="text-center">Max Score</th>
                            <th class="text-center">Average</th>
                            <th>Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in criteria)
                        {
                            var avg = averages.ContainsKey(c.Id) ? averages[c.Id] : 0m;
                            var pct = c.MaxScore > 0 ? (double)(avg / c.MaxScore) * 100 : 0;
                            <tr>
                                <td>@c.CriterionName</td>
                                <td class="text-center">@c.MaxScore</td>
                                <td class="text-center">
                                    <strong>@avg.ToString("F1")</strong>
                                </td>
                                <td>
                                    <div class="progress" style="height:20px;">
                                        <div class="progress-bar bg-@(pct >= 75 ? "success" : pct >= 50 ? "warning" : "danger")"
                                             style="width:@pct.ToString("F0")%">
                                            @pct.ToString("F0")%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2"><strong>Overall Average</strong></td>
                            <td class="text-center">
                                <strong>@(averages.Values.Sum().ToString("F1")) / @criteria.Sum(c => c.MaxScore)</strong>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Individual remarks -->
        @{
            var withRemarks = submissions.Where(s => !string.IsNullOrWhiteSpace(s.Remarks)).ToList();
        }
        @if (withRemarks.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-comments me-2"></i>Student Remarks</h5>
                </div>
                <div class="card-body">
                    @foreach (var sub in withRemarks)
                    {
                        <blockquote class="blockquote border-start ps-3 mb-3">
                            <p class="mb-0 fst-italic">"@sub.Remarks"</p>
                            <footer class="blockquote-footer text-muted">Submitted @sub.SubmittedAt?.ToString("dd MMM yyyy")</footer>
                        </blockquote>
                    }
                </div>
            </div>
        }
    }

    <div class="mt-3">
        <a asp-action="Sessions" asp-controller="TeachingAppraisal" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Sessions
        </a>
    </div>
</div>
