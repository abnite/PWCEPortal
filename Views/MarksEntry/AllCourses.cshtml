@model IEnumerable<PWCEPortal.Models.Academic.CourseLecturerAssignment>
@{
    ViewBag.Title = "All Course Marks";
    Layout = "_AdminLayout";
    var semester = ViewBag.Semester as PWCEPortal.Models.Academic.AcademicSemester;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">All Courses – Marks Overview</h1>
    </div>

    @if (semester != null)
    {
        <div class="alert alert-info">
            <i class="fas fa-calendar-alt me-2"></i>
            Current Semester: <strong>@semester.AcademicYear?.Year – @semester.SemesterName</strong>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course</th>
                            <th>Code</th>
                            <th>Level</th>
                            <th>Lecturer</th>
                            <th class="text-center">Marks Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var submission = a.Submissions?.FirstOrDefault();
                            var badgeClass = submission?.Status switch
                            {
                                PWCEPortal.Models.Academic.SubmissionStatus.Draft => "bg-secondary",
                                PWCEPortal.Models.Academic.SubmissionStatus.SubmittedForReview => "bg-warning text-dark",
                                PWCEPortal.Models.Academic.SubmissionStatus.HODApproved => "bg-info text-dark",
                                PWCEPortal.Models.Academic.SubmissionStatus.HODRejected => "bg-danger",
                                PWCEPortal.Models.Academic.SubmissionStatus.QAApproved => "bg-primary",
                                PWCEPortal.Models.Academic.SubmissionStatus.PrincipalApproved => "bg-success",
                                PWCEPortal.Models.Academic.SubmissionStatus.Unlocked => "bg-warning text-dark",
                                _ => "bg-light text-muted"
                            };
                            <tr>
                                <td><strong>@a.Course?.CourseName</strong></td>
                                <td><span class="custom-badge bg-secondary">@a.Course?.CourseCode</span></td>
                                <td>Level @a.Course?.Level</td>
                                <td>@a.Lecturer?.User?.LastName @a.Lecturer?.User?.FirstName</td>
                                <td class="text-center">
                                    @if (submission != null)
                                    {
                                        <span class="custom-badge @badgeClass">@submission.Status</span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge bg-light text-muted">Not Started</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="EnterMarks" asp-route-assignmentId="@a.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye me-1"></i>View Marks
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">No course assignments found for the current semester.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
