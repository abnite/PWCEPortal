@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ViewModel.Account.UserRegistrationViewModel

@{
    ViewBag.Title = "Edit User";
    Layout = "_AdminLayout";
    
    var getRoles = await db.Roles.ToListAsync();
}


<div class="card mt-4">
    <div class="card-header">
        <h3>Edit User</h3>
    </div>
    <div class="card-body">
        <hr>
        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="form-group col-md-6">
                    <label asp-for="FirstName"  class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="LastName"  class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label asp-for="EmailAddress"  class="form-label"></label>
                    <input asp-for="EmailAddress" class="form-control" />
                    <span asp-validation-for="EmailAddress" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="PhoneNumber"  class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label asp-for="Role"  class="form-label"></label>
                    <select id="Role" asp-for="Role" class="form-control">
                        <option value="">Select Role</option>
                        @foreach (var role in getRoles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6" id="departmentSection">
                    <label asp-for="DepartmentId" class="form-label">
                        Department / Unit
                        <small class="text-muted">(required for HOD and Unit Head)</small>
                    </label>
                    <select asp-for="DepartmentId" class="form-control">
                        <option value="">-- None --</option>
                        @if (ViewBag.Departments is IEnumerable<PWCEPortal.Models.Academic.Department> depts)
                        {
                            @foreach (var dept in depts)
                            {
                                <option value="@dept.Id">@dept.DepartmentName</option>
                            }
                        }
                    </select>
                    <span class="form-text text-muted">
                        Assigning a department scopes this user to only manage staff/lecturers in that department.
                    </span>
                </div>
            </div>
            <hr/>
            <button type="submit" class="btn btn-success">Update User</button>
        </form>
    </div>
</div>


@section Scripts {
}