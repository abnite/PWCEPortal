@model PWCEPortal.ViewModel.Account.SetPasswordViewModel

@{
    ViewBag.Title = "title";
    Layout = "_LoginLayout";
}


    <div class="login-header">
        <h2>Set Your New Password</h2>
        <p>Please log in to access your account.</p>
    </div>
    <form asp-action="SetPassword" method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div class="form-group">
            <label asp-for="NewPassword">New Password</label>
            <input asp-for="NewPassword" type="password"  required/>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <!-- In a real scenario, the token would be passed via the query string and hidden input -->
        <div class="form-group">
            <label asp-for="ConfirmPassword">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" required/>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit">Set Password</button>
    </form>
    <div class="login-footer">
        <a asp-action="Login" asp-controller="Account">Back to Login</a>
    </div>

