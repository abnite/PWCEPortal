@model PWCEPortal.ViewModel.Account.ResetPasswordViewModel

@{
    ViewBag.Title = "title";
    Layout = "_LoginLayout";
}


    <div class="login-header">
        <h2>Set Your New Password</h2>
        <p>Please log in to access your account.</p>
    </div>
<form asp-action="ResetPassword" role="form" method="post" enctype="multipart/form-data" asp-controller="Account" eval="CloseForm(data,$ajaxTarget,XHR)">
    <input type="hidden" asp-for="Email"/>
    <input type="hidden" asp-for="Token"/>
    <div class="row">
        <h3> Password Reset</h3>
        <p></p>


        <div class="form-group col-lg-12">
            <label>Password</label>
            <input class="form-control" asp-for="Password" type="password">
            <span class="text-red" asp-validation-for="Password"></span>
        </div>
        <div class="form-group col-lg-12">
            <label>Confirm Password </label>
            <input class="form-control" asp-for="ConfirmPassword" type="password">
            <span class="text-red" asp-validation-for="ConfirmPassword"></span>
        </div>

    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 10px;">
        <button type="submit" class="btn btn-success login btn">Reset</button>
        <a title="Click To Register" style="color: #0b5ed7" asp-controller="Account" asp-action="Login">Cancel</a>
    </div>
</form>



<div class="login-footer">
    <a asp-action="Login" asp-controller="Account">Back to Login</a>
</div>


