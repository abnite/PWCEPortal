@model PWCEPortal.ViewModel.Student.FinancialInfoViewModel

@{
    ViewBag.Title = "Delete Financial Info";
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-header bg-danger text-white">
        <h3 class="card-title">Delete Financial Info</h3>
    </div>
    <div class="card-body">
        <h4>Are you sure you want to delete this financial info?</h4>
        <div>
            <dl class="row">
                <dt class="col-sm-3">SSNIT Number</dt>
                <dd class="col-sm-9">@Model.SSNITNumber</dd>

                <dt class="col-sm-3">EZwich Account Name</dt>
                <dd class="col-sm-9">@Model.EZwichAccountName</dd>

                <dt class="col-sm-3">EZwich Account Number</dt>
                <dd class="col-sm-9">@Model.EZwichAccountNumber</dd>
            </dl>
        </div>

        <form asp-action="DeleteFinancialInfo" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="StudentId" />
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <a asp-action="EditProfile" asp-route-studentId="@Model.StudentId" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>