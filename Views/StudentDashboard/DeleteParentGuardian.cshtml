@model PWCEPortal.ViewModel.Student.ParentGuardianViewModel

@{
    ViewBag.Title = "Delete Parent/Guardian";
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-header bg-danger text-white">
        <h3 class="card-title">Delete Parent/Guardian</h3>
    </div>
    <div class="card-body">
        <h4>Are you sure you want to delete this parent/guardian?</h4>
        <div>
            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Telephone</dt>
                <dd class="col-sm-9">@Model.Telephone</dd>

                <dt class="col-sm-3">Occupation</dt>
                <dd class="col-sm-9">@Model.Occupation</dd>

                <dt class="col-sm-3">Contact Address</dt>
                <dd class="col-sm-9">@Model.ContactAddress</dd>

                <dt class="col-sm-3">Relationship</dt>
                <dd class="col-sm-9">@Model.Relationship</dd>
            </dl>
        </div>

        <form asp-action="DeleteParentGuardian" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="StudentId" />
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <a asp-action="EditProfile" asp-route-studentId="@Model.StudentId" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>