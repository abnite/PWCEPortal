@model PWCEPortal.ViewModel.Student.EducationHistoryViewModel

@{
    ViewBag.Title = "Delete Education History";
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-header bg-danger text-white">
        <h3 class="card-title">Delete Education History</h3>
    </div>
    <div class="card-body">
        <h4>Are you sure you want to delete this education history?</h4>
        <div>
            <dl class="row">
                <dt class="col-sm-3">School Name</dt>
                <dd class="col-sm-9">@Model.SchoolName</dd>

                <dt class="col-sm-3">From Date</dt>
                <dd class="col-sm-9">@Model.FromDate.ToShortDateString()</dd>

                <dt class="col-sm-3">To Date</dt>
                <dd class="col-sm-9">@Model.ToDate.ToShortDateString()</dd>

                <dt class="col-sm-3">Office Held</dt>
                <dd class="col-sm-9">@Model.OfficeHeld</dd>
            </dl>
        </div>

        <form asp-action="DeleteEducationHistory" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="StudentId" />
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <a asp-action="EditProfile" asp-route-studentId="@Model.StudentId" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>