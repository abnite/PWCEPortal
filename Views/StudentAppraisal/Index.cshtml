@using PWCEPortal.Models.Staff
@model List<TeachingAppraisalSession>
@{
    ViewBag.Title = "Course Appraisals";
    Layout = "_AdminLayout";
    var studentId = (Guid)ViewBag.StudentId;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Course Appraisals</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="StudentDashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">Course Appraisals</li>
            </ol>
        </nav>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-comment-alt me-2"></i>Open Appraisal Sessions</h5>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-clipboard fa-3x mb-3 d-block"></i>
                    <p>No open appraisal sessions at this time. Check back later.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var session in Model)
                    {
                        var mySubmission = session.Submissions?.FirstOrDefault(s => s.StudentId == studentId);
                        var isSubmitted = mySubmission?.IsSubmitted ?? false;
                        var hasDraft = mySubmission != null && !isSubmitted;

                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 border-@(isSubmitted ? "success" : hasDraft ? "warning" : "primary")">
                                <div class="card-header bg-@(isSubmitted ? "success" : hasDraft ? "warning" : "primary") text-white">
                                    <h6 class="mb-0">
                                        <i class="fas fa-book me-1"></i>
                                        @session.Assignment?.Course?.CourseName
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <p class="mb-1">
                                        <strong>Lecturer:</strong>
                                        @(session.Assignment?.Lecturer?.User?.FirstName + " " + session.Assignment?.Lecturer?.User?.LastName)
                                    </p>
                                    <p class="mb-1">
                                        <strong>Template:</strong> @session.AppraisalTemplate?.TemplateName
                                    </p>
                                    <p class="mb-2">
                                        <strong>Academic Year:</strong> @session.AcademicYear?.Year
                                    </p>
                                    @if (isSubmitted)
                                    {
                                        <span class="custom-badge bg-success"><i class="fas fa-check me-1"></i>Submitted</span>
                                        <p class="text-muted small mt-1">Score: @mySubmission!.TotalScore?.ToString("F1")</p>
                                    }
                                    else if (hasDraft)
                                    {
                                        <span class="custom-badge bg-warning text-dark"><i class="fas fa-edit me-1"></i>Draft saved</span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge bg-secondary"><i class="fas fa-clock me-1"></i>Not started</span>
                                    }
                                </div>
                                <div class="card-footer">
                                    @if (!isSubmitted)
                                    {
                                        <a asp-action="FillIn" asp-controller="StudentAppraisal"
                                           asp-route-sessionId="@session.Id"
                                           class="btn btn-sm btn-@(hasDraft ? "warning" : "primary") w-100">
                                            <i class="fas fa-edit me-1"></i>
                                            @(hasDraft ? "Continue Appraisal" : "Start Appraisal")
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success w-100" disabled>
                                            <i class="fas fa-check me-1"></i>Completed
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
