@model PWCEPortal.ViewModel.Academic.CourseRegistrationViewModel
@{
    ViewData["Title"] = "Course Registration";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="card border-0 shadow-lg rounded-lg overflow-hidden">
        <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="fas fa-book fa-2x me-3"></i>
                <div>
                    <h4 class="mb-0">Course Registration</h4>
                    <p class="mb-0 small opacity-75">@Model.StudentName</p>
                </div>
            </div>
            <a href="@Url.Action("Index", "StudentDashboard")" class="btn btn-light btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Dashboard
            </a>
        </div>
        
        <div class="card-body p-4">
            <div class="alert alert-primary d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x me-3"></i>
                <div>
                    <h5 class="alert-heading mb-2">Registration Information</h5>
                    <div class="d-flex flex-wrap gap-3">
                        <span class="custom-badge bg-primary">
                            <i class="fas fa-graduation-cap me-1"></i> @Model.ProgramName
                        </span>
                        <span class="custom-badge bg-info">
                            <i class="fas fa-layer-group me-1"></i> Level @Model.CurrentLevel
                        </span>
                        <span class="custom-badge bg-success">
                            <i class="fas fa-calendar-alt me-1"></i> @Model.Semester
                        </span>
                    </div>
                </div>
            </div>

            <form asp-action="RegisterCourses" method="post">
                <input type="hidden" asp-for="StudentId" />
                <input type="hidden" asp-for="CollegeProgramId" />
                
                @if (Model.AvailableCourses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th width="50px" class="text-center">
                                        <input type="checkbox" id="selectAll" class="form-check-input">
                                    </th>
                                    <th><i class="fas fa-hashtag me-1"></i> Code</th>
                                    <th><i class="fas fa-book me-1"></i> Course Name</th>
                                    <th><i class="fas fa-tag me-1"></i> Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.AvailableCourses.Count; i++)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   name="SelectedCourseIds"
                                                   value="@Model.AvailableCourses[i].CourseId"
                                                   class="form-check-input course-checkbox" />
                                        </td>
                                        <td class="fw-bold">@Model.AvailableCourses[i].CourseCode</td>
                                        <td>@Model.AvailableCourses[i].CourseName</td>
                                        <td>
                                            <span class="custom-badge @(Model.AvailableCourses[i].CourseType == "Core" ? "bg-primary" : "bg-warning text-dark")">
                                                <i class="@(Model.AvailableCourses[i].CourseType == "Core" ? "fas fa-star" : "fas fa-bookmark") me-1"></i>
                                                @Model.AvailableCourses[i].CourseType
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i> Select courses to register
                        </div>
                        <div>
                            <a href="@Url.Action("Index", "StudentDashboard")" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-1"></i> Submit Registration
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center py-5">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <h4>No Courses Available</h4>
                        <p class="mb-0">There are currently no courses available for registration.</p>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    .card {
        border-radius: 0.5rem;
    }
    .card-header {
        border-radius: 0 !important;
    }
    .bg-gradient-primary {
        background: linear-gradient(135deg, #3f51b5 0%, #2196f3 100%);
    }
    .table th {
        white-space: nowrap;
        border-top: none;
    }
    .table td {
        vertical-align: middle;
    }
    .badge {
        font-weight: 500;
        padding: 0.5em 0.75em;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
    .course-checkbox {
        transform: scale(1.3);
    }
    #selectAll {
        transform: scale(1.2);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select all checkbox functionality
            $('#selectAll').change(function() {
                $('.course-checkbox').prop('checked', $(this).prop('checked'));
            });
            
            // Uncheck "select all" if any course checkbox is unchecked
            $('.course-checkbox').change(function() {
                if (!$(this).prop('checked')) {
                    $('#selectAll').prop('checked', false);
                }
            });
            
            // Validate at least one course is selected
            $('form').submit(function(e) {
                if ($('.course-checkbox:checked').length === 0) {
                    alert('Please select at least one course to register');
                    e.preventDefault();
                }
            });
        });
    </script>
}