@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>PWCE School Portal @ViewData["Title"]</title>
    <link rel="icon" href="~/images/PWCELogo.png" type="image/png">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .custom-badge {
            padding: .25em .6em;
            border-radius: .25rem;
            color: white;
            font-size: .75em;
        }
    </style>
</head>
<body>
<div class="wrapper">
    <header class="main-header">
        <div class="header-left">
            <button id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
            <div class="logo">
                <img src="~/images/PWCELogo.png" alt="School Logo">
                <span>PWCE School Portal</span>
            </div>
        </div>
        <div class="header-right">
            <div class="user-actions">
                <div class="notifications">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </div>

                <div class="user-profile">
                    <div class="profile-info">
                        <img src="~/images/user.png" alt="User Avatar">
                        @{
                            if (SignInManager.IsSignedIn(User))
                            {
                                var userName = User.Identity.Name;
                                var UserInfo =await db.Users.Where(i => i.UserName == userName).FirstOrDefaultAsync();

                                <span> @UserInfo.LastName</span>

                            }
                        }
                       
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="dropdown-menu">
                        <a href="#"><i class="fas fa-user"></i> Visit Profile</a>
                        <a asp-action="ChangePassword" asp-controller="Account"><i class="fas fa-key"></i> Change Password</a>
                        <a asp-action="Logout" asp-controller="Account"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </header>
    @await Html.PartialAsync("SideMenu")
    <main class="content">
        <section class="content-header">
            @{
                if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible" id="DIVHide" style="margin:10px">
                        <button class="close" aria-hidden="true" type="button" data-dismiss="alert">×</button>
                        <Center><i class="icon fa fa-check"></i>   @TempData["SuccessMessage"]</Center>

                    </div>
                }
                if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible" id="DIVHide" style="margin:10px">
                        <button class="close" aria-hidden="true" type="button" data-dismiss="alert">×</button>
                        <Center><i class="icon fa fa-check"></i>   @TempData["ErrorMessage"]</Center>

                    </div>
                }
            }
        </section>

        @RenderBody()
        
    </main>
    <!-- Footer -->
    <footer class="main-footer">
        <p>Copyright &copy;  @DateTime.UtcNow.Year PWCE Student Portal. All rights reserved.</p>
    </footer>


</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Custom JS -->
<script src="~/js/script.js"></script>

<script>
    $(document).ready(function () {
        // Initialize Select2
        $('.select2').select2();

        // Initialize DataTables
        $('#table1').DataTable();
    });

    $(document).ready(function () {
        setTimeout(function () {
            $('#DIVHide').fadeOut('slow');
        }, 5000); // Hides after 5 seconds
    });
</script>
@RenderSection("Scripts", required: false)
</body>
</html>