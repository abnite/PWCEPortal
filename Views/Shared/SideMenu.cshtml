<!-- Sidebar -->
<aside class="main-sidebar">
    <nav>
        <br>
        
        <ul>
            <!-- Dashboard Links -->
            @if (User.IsInRole("System Admin") || User.IsInRole("Administrator"))
            {
                <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "AdminDashboard" ? "active" : "")">

                    <a asp-action="Index" asp-controller="AdminDashboard">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            }
            @if (User.IsInRole("Student") || User.IsInRole("System Admin"))
            {
                <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "StudentDashboard" ? "active" : "")">
                    <a asp-action="Index" asp-controller="StudentDashboard">
                        <i class="fas fa-home"></i>
                        <span>Student Dashboard</span>
                    </a>
                </li>
                @if (User.IsInRole("Student"))
                {
                    var userName = User.Identity.Name;
                    var UserInfo =await db.Users.Where(i => i.UserName == userName).FirstOrDefaultAsync();

                    var Student = await _Context.Students.Where(i => i.Email == UserInfo.Email).FirstOrDefaultAsync();
                    
                    <li><a asp-action="ViewRegisteredCourses" asp-controller="Academic" asp-route-studentId="@Student.Id">
                            <i class="fas fa-eye"></i> View My Registered Courses</a>
                    </li>
                }
                     

            }
            @if (User.IsInRole("Finance Officer") || User.IsInRole("System Admin"))
            {
                <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "FinanceDashboard" ? "active" : "")">
                    <a asp-action="Index" asp-controller="FinanceDashboard">
                        <i class="fas fa-home"></i>
                        <span>Finance Dashboard</span>
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "FinanceDashboard" ? "active" : "")">
                    <a asp-action="UploadPreviousOutstandingFees" asp-controller="FinanceDashboard">
                        <i class="fas fa-home"></i>
                        <span>Upload OutStanding Fees</span>
                    </a>
                </li>
                
                <li  class="@(ViewContext.RouteData.Values["Controller"].ToString() == "FinanceDashboard" ? "active" : "")">
                    <a class="nav-link" asp-action="LegacyOutstandingFeesList" asp-controller="FinanceDashboard">
                        <i class="fas fa-history"></i> 
                        <span>Legacy Fees</span>
                    </a>
                </li>
            }

            <!-- Academics Section -->
            @if (User.IsInRole("System Admin"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "AdminDashboard" &&
                                      (ViewContext.RouteData.Values["Action"].ToString() == "AcademicYears" ||
                                       ViewContext.RouteData.Values["Action"].ToString() == "ManageAcademicSemesters" ||
                                       ViewContext.RouteData.Values["Action"].ToString() == "ManagePrograms" ||
                                       ViewContext.RouteData.Values["Action"].ToString() == "ManageCourses" ||
                                       ViewContext.RouteData.Values["Action"].ToString() == "PromoteStudents")
                                        ? "active"
                                        : "")">
                    <a href="#">
                        <i class="fas fa-book"></i>
                        <span>Academics</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        <li><a asp-action="AcademicYears" asp-controller="AdminDashboard"><i class="fas fa-calendar-alt"></i> Academic Year</a></li>
                        <li><a asp-action="ManageAcademicSemesters" asp-controller="AdminDashboard"><i class="fas fa-calendar-alt"></i> Academic Semester</a></li>
                        <li><a asp-action="ViewAllRegistrations" asp-controller="Academic" class="nav-link">
                            <i class="fas fa-list-alt"></i> View All Registrations</a>
                        </li>
                        <li><a asp-action="ManagePrograms" asp-controller="AdminDashboard"><i class="fas fa-graduation-cap"></i> Programs</a></li>
                        <li><a asp-action="ManageCourses" asp-controller="AdminDashboard"><i class="fas fa-book-open"></i> Courses</a></li>
                        <a href="@Url.Action("UploadCourses", "AdminDashboard")" class="btn btn-outline-success">
                            <i class="fas fa-file-excel me-1"></i> Bulk Upload Courses
                        </a>
                        
                        <li><a asp-action="PromoteStudents" asp-controller="AdminDashboard"><i class="fas fa-user-graduate"></i> Promote Students</a></li>
                    </ul>
                </li>
            }

            <!-- Students Section -->
            @if (User.IsInRole("System Admin") || User.IsInRole("Student Records Officer") || User.IsInRole("Registrar"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "Student" ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-users"></i>
                        <span>Students</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        <li><a asp-action="Index" asp-controller="Student"><i class="fas fa-user-plus"></i> Students</a></li>
                        <li><a asp-action="UploadStudents" asp-controller="Student"><i class="fas fa-file-upload"></i> Upload Students</a></li>
                    </ul>
                </li>
            }

            <!-- Fees Section -->
            @if (User.IsInRole("Finance Officer") || User.IsInRole("System Admin"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "AdminDashboard" &&
                                      (ViewContext.RouteData.Values["Action"].ToString() == "ManageFeeStructures" ||
                                       ViewContext.RouteData.Values["Action"].ToString() == "ManagePartPaymentConfigs" ||
                                       ViewContext.RouteData.Values["Action"].ToString() == "ManageRequiredFees")
                                        ? "active"
                                        : "")">
                    <a href="#">
                        <i class="fas fa-dollar-sign"></i>
                        <span>Fees</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        <li><a asp-action="ManageFeeStructures" asp-controller="AdminDashboard"><i class="fas fa-money-check-alt"></i> Fees Structure</a></li>
                        <li><a asp-action="ManagePartPaymentConfigs" asp-controller="AdminDashboard"><i class="fas fa-money-bill-wave"></i> Part Payment Config</a></li>
                        <li><a asp-action="ManageRequiredFees" asp-controller="AdminDashboard"><i class="fas fa-money-bill-wave"></i> Required Fees Config</a></li>
                    </ul>
                </li>
            }

            @if (!User.IsInRole("Student"))
            {
                <!-- Reports Section -->
                <li class="dropdown">
                    <a href="#">
                        <i class="fas fa-chart-bar"></i>
                        <span>Reports</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        <li><a asp-action="Index" asp-controller="Reports"><i class="fas fa-chart-line"></i> Report Dashboard</a></li>
                        <li><a asp-action="NoStudentsByCourse" asp-controller="Reports"><i class="fas fa-users"></i> No. Students for a Course</a></li>
                        <li><a asp-action="AllActiveStudents" asp-controller="Reports"><i class="fas fa-graduation-cap"></i> All Active Students</a></li>
                        <li><a asp-action="TransferredStudents" asp-controller="Reports"><i class="fas fa-exchange-alt"></i> Transfer Students</a></li>
                        <li><a asp-action="DroppedOutStudents" asp-controller="Reports"><i class="fas fa-user-minus"></i> Dropped Out Students</a></li>
                        <li><a asp-action="DeferredStudents" asp-controller="Reports"><i class="fas fa-pause-circle"></i> Deferred Students</a></li>
                        <li><a asp-action="GraduatedStudents" asp-controller="Reports"><i class="fas fa-graduation-cap"></i> Graduated Students</a></li>
                        <li><a asp-action="Index" asp-controller="Student"><i class="fas fa-user-graduate"></i> Student Report</a></li>
                        <li><a asp-action="AllFinancialInfoStudents" asp-controller="Reports"><i class="fas fa-money-bill-wave"></i> Student Financial Details</a></li>

                        <li><a asp-action="ViewAllRegistrations" asp-controller="Academic"><i class="fas fa-list-alt"></i> View All Registrations</a></li>
                        @if (User.IsInRole("System Admin")|| User.IsInRole("Finance Officer") || User.IsInRole("Administrator") )
                        {
                            <li><a asp-action="PaymentReport" asp-controller="Reports"><i class="fas fa-credit-card"></i> Payment Report</a></li>
                            <li><a asp-action="LegacyOutstandingFeesReport" asp-controller="Reports"><i class="fas fa-credit-card"></i> Legacy Outstanding Fees</a></li>
               
                            @if (User.IsInRole("System Admin"))
                            {
                                <li><a asp-action="AuditLogReport" asp-controller="Reports"><i class="fas fa-clipboard-list"></i> Audit Report</a></li>
                            }

                            <li><a asp-action="RevenueReport" asp-controller="Reports"><i class="fas fa-money-bill-wave"></i> Revenue Report</a></li>
                            <li><a asp-action="OutstandingFees" asp-controller="FinanceDashboard"><i class="fas fa-exclamation-circle"></i> Outstanding Balances</a></li>
                            <li><a asp-action="OverPaymentFees" asp-controller="Reports"><i class="fas fa-coins"></i> Overpayments</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Settings Section -->
            @if (User.IsInRole("System Admin"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "Account" ||
                                      (ViewContext.RouteData.Values["Controller"].ToString() == "AdminDashboard" &&
                                       (ViewContext.RouteData.Values["Action"].ToString() == "CollegeHalls" ||
                                        ViewContext.RouteData.Values["Action"].ToString() == "CollegeClass"))
                                        ? "active"
                                        : "")">
                    <a href="#">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        <li><a asp-action="AddUser" asp-controller="Account"><i class="fas fa-user-plus"></i> Add User</a></li>
                        <li><a asp-action="CollegeHalls" asp-controller="AdminDashboard"><i class="fas fa-building"></i> Manage Halls</a></li>
                        <li><a asp-action="CollegeClass" asp-controller="AdminDashboard"><i class="fas fa-chalkboard"></i> Manage Classes</a></li>
                        <!--<li><a asp-action="CreateBackup" asp-controller="AdminDashboard"><i class="fas fa-chalkboard"></i> Backup Database</a></li>-->
                    </ul>
                </li>
            }

            <!-- Phase 2: My Work (Lecturers) -->
            @if (User.HasClaim("Permission", "Permissions.MarksEntry.ViewOwn") || User.HasClaim("Permission", "Permissions.TeachingAppraisal.ViewOwn"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "MarksEntry" || (ViewContext.RouteData.Values["Controller"].ToString() == "TeachingAppraisal" && ViewContext.RouteData.Values["Action"].ToString() == "MyAppraisals") ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-pencil-alt"></i>
                        <span>My Work</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        @if (User.HasClaim("Permission", "Permissions.MarksEntry.ViewOwn"))
                        {
                            <li><a asp-action="MyStudents" asp-controller="MarksEntry"><i class="fas fa-users"></i> My Students</a></li>
                            <li><a asp-action="Index" asp-controller="MarksEntry"><i class="fas fa-keyboard"></i> Enter Marks</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.TeachingAppraisal.ViewOwn"))
                        {
                            <li><a asp-action="MyAppraisals" asp-controller="TeachingAppraisal"><i class="fas fa-star"></i> My Appraisals</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Phase 2: Student Course Appraisals -->
            @if (User.HasClaim("Permission", "Permissions.TeachingAppraisal.StudentAppraise"))
            {
                <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "StudentAppraisal" ? "active" : "")">
                    <a asp-action="Index" asp-controller="StudentAppraisal">
                        <i class="fas fa-comment-alt"></i>
                        <span>Course Appraisals</span>
                    </a>
                </li>
            }

            <!-- Phase 2: HOD (Course Assignment & Approvals) -->
            @if (User.HasClaim("Permission", "Permissions.CourseLecturer.View") || User.HasClaim("Permission", "Permissions.AssessmentApproval.HODReview") || User.HasClaim("Permission", "Permissions.TeachingAppraisal.ConductAsHOD") || User.HasClaim("Permission", "Permissions.MarksEntry.ViewAllCourses"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "CourseLecturer" || ViewContext.RouteData.Values["Controller"].ToString() == "AssessmentApproval" || (ViewContext.RouteData.Values["Controller"].ToString() == "TeachingAppraisal" && ViewContext.RouteData.Values["Action"].ToString() == "Sessions") ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-chalkboard-teacher"></i>
                        <span>HOD</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        @if (User.HasClaim("Permission", "Permissions.CourseLecturer.View"))
                        {
                            <li><a asp-action="Index" asp-controller="CourseLecturer"><i class="fas fa-link"></i> Course Assignments</a></li>
                            <li><a asp-action="Lecturers" asp-controller="CourseLecturer"><i class="fas fa-user-tie"></i> Lecturers</a></li>
                            <li><a asp-action="Departments" asp-controller="CourseLecturer"><i class="fas fa-sitemap"></i> Departments</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.MarksEntry.ViewAllCourses"))
                        {
                            <li><a asp-action="AllCourses" asp-controller="MarksEntry"><i class="fas fa-table"></i> All Course Marks</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.AssessmentApproval.HODReview"))
                        {
                            <li><a asp-action="Pending" asp-controller="AssessmentApproval"><i class="fas fa-tasks"></i> Assessment Approvals</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.TeachingAppraisal.ConductAsHOD"))
                        {
                            <li><a asp-action="Sessions" asp-controller="TeachingAppraisal"><i class="fas fa-clipboard-check"></i> Appraisal Sessions</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Phase 2: QA / Principal Assessment Approvals -->
            @if (User.HasClaim("Permission", "Permissions.AssessmentApproval.QAReview") || User.HasClaim("Permission", "Permissions.AssessmentApproval.PrincipalApprove"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "AssessmentApproval" ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-clipboard-check"></i>
                        <span>Assessment Approvals</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        <li><a asp-action="Pending" asp-controller="AssessmentApproval"><i class="fas fa-tasks"></i> Approval Queue</a></li>
                    </ul>
                </li>
            }

            <!-- Phase 2: Unit Head (Non-Teaching Staff in their dept) -->
            @if (User.IsInRole("Unit Head") || (User.HasClaim("Permission", "Permissions.NonTeachingStaff.View") && !User.HasClaim("Permission", "Permissions.TeachingAppraisal.ViewAll") && !User.IsInRole("HR Officer")))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "NonTeachingStaff" ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-users-cog"></i>
                        <span>Unit Head</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.View"))
                        {
                            <li><a asp-action="Index" asp-controller="NonTeachingStaff"><i class="fas fa-id-badge"></i> My Department Staff</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.Appraise"))
                        {
                            <li><a asp-action="StartAppraisal" asp-controller="NonTeachingStaff"><i class="fas fa-play-circle"></i> Start Appraisal</a></li>
                            <li><a asp-action="Appraisals" asp-controller="NonTeachingStaff"><i class="fas fa-clipboard-list"></i> Appraisal Records</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.Manage"))
                        {
                            <li><a asp-action="Create" asp-controller="NonTeachingStaff"><i class="fas fa-user-plus"></i> Add Staff Member</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Phase 2: Academic Affairs -->
            @if (User.HasClaim("Permission", "Permissions.AssessmentStructure.View") || User.HasClaim("Permission", "Permissions.StudentResults.ViewAll") || User.HasClaim("Permission", "Permissions.StudentResults.ViewOwn") || User.HasClaim("Permission", "Permissions.StudentResults.ViewByDepartment"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "AssessmentStructure" || ViewContext.RouteData.Values["Controller"].ToString() == "StudentResults" ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-graduation-cap"></i>
                        <span>Academic Affairs</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        @if (User.HasClaim("Permission", "Permissions.AssessmentStructure.View"))
                        {
                            <li><a asp-action="Index" asp-controller="AssessmentStructure"><i class="fas fa-layer-group"></i> Assessment Structures</a></li>
                            <li><a asp-action="GradingScales" asp-controller="AssessmentStructure"><i class="fas fa-star-half-alt"></i> Grading Scales</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.StudentResults.ViewAll") || User.HasClaim("Permission", "Permissions.StudentResults.ViewByDepartment"))
                        {
                            <li><a asp-action="AllResults" asp-controller="StudentResults"><i class="fas fa-poll"></i> Results Management</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.StudentResults.ViewOwn"))
                        {
                            <li><a asp-action="MyResults" asp-controller="StudentResults"><i class="fas fa-chart-bar"></i> My Results</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Phase 2: Transcripts -->
            @if (User.HasClaim("Permission", "Permissions.Transcripts.GenerateOwn") || User.HasClaim("Permission", "Permissions.Transcripts.GenerateOfficial") || User.HasClaim("Permission", "Permissions.Transcripts.ViewLog"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "Transcript" ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-file-alt"></i>
                        <span>Transcripts</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        @if (User.HasClaim("Permission", "Permissions.Transcripts.GenerateOwn"))
                        {
                            <li><a asp-action="MyTranscript" asp-controller="Transcript"><i class="fas fa-file-pdf"></i> My Transcript</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.Transcripts.GenerateOfficial"))
                        {
                            <li><a asp-action="Generate" asp-controller="Transcript"><i class="fas fa-print"></i> Generate Official</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.Transcripts.ViewLog"))
                        {
                            <li><a asp-action="Log" asp-controller="Transcript"><i class="fas fa-history"></i> Transcript Log</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Phase 2: Appraisals & Non-Teaching Staff -->
            @if (User.HasClaim("Permission", "Permissions.TeachingAppraisal.ViewAll") || User.HasClaim("Permission", "Permissions.TeachingAppraisal.ConfigureTemplate") || User.HasClaim("Permission", "Permissions.NonTeachingStaff.View") || User.HasClaim("Permission", "Permissions.NonTeachingStaff.Appraise") || User.HasClaim("Permission", "Permissions.NonTeachingStaff.ViewReports"))
            {
                <li class="dropdown @(ViewContext.RouteData.Values["Controller"].ToString() == "TeachingAppraisal" || ViewContext.RouteData.Values["Controller"].ToString() == "NonTeachingStaff" ? "active" : "")">
                    <a href="#">
                        <i class="fas fa-clipboard-check"></i>
                        <span>Appraisals</span>
                        <i class="fas fa-chevron-down dropdown-icon"></i>
                    </a>
                    <ul class="submenu">
                        @if (User.HasClaim("Permission", "Permissions.TeachingAppraisal.ViewAll"))
                        {
                            <li><a asp-action="Index" asp-controller="TeachingAppraisal"><i class="fas fa-chalkboard-teacher"></i> All Teaching Appraisals</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.TeachingAppraisal.ConfigureTemplate"))
                        {
                            <li><a asp-action="Templates" asp-controller="TeachingAppraisal"><i class="fas fa-file-invoice"></i> Appraisal Templates</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.View"))
                        {
                            <li><a asp-action="Index" asp-controller="NonTeachingStaff"><i class="fas fa-users-cog"></i> Non-Teaching Staff</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.Appraise"))
                        {
                            <li><a asp-action="StartAppraisal" asp-controller="NonTeachingStaff"><i class="fas fa-play-circle"></i> Start Appraisal</a></li>
                        }
                        @if (User.HasClaim("Permission", "Permissions.NonTeachingStaff.ViewReports") || User.HasClaim("Permission", "Permissions.NonTeachingStaff.Appraise"))
                        {
                            <li><a asp-action="Appraisals" asp-controller="NonTeachingStaff"><i class="fas fa-clipboard-list"></i> Non-Teaching Appraisals</a></li>
                        }
                    </ul>
                </li>
            }

            <!-- Role Permissions -->
            @if (User.IsInRole("System Admin"))
            {
                <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Permissions" ? "active" : "")">
                    <a asp-action="Index" asp-controller="Permissions">
                        <i class="fas fa-lock"></i>
                        <span>Role Permissions</span>
                    </a>
                </li>
            }

            <!-- Logout -->
            <li>
                <a asp-action="Logout" asp-controller="Account">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>