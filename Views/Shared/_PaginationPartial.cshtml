@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PWCEPortal.ViewModel.Reports.PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">

            @{
                // Extract and override route values safely
                var routeValues = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
            }

            <!-- First Page -->
            @{
                routeValues["pageNumber"] = "1";
            }
            <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-all-route-data="routeValues">
                    &laquo;&laquo;
                </a>
            </li>

            <!-- Previous Page -->
            @if (Model.HasPreviousPage)
            {
                routeValues["pageNumber"] = (Model.PageIndex - 1).ToString();
            }
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-all-route-data="routeValues">
                    &laquo;
                </a>
            </li>

            @{
                int startPage = Math.Max(1, Model.PageIndex - 2);
                int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);

                // Show first page if not in range
                if (startPage > 1)
                {
                    routeValues["pageNumber"] = "1";
                    <li class="page-item @(1 == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="@ViewContext.RouteData.Values["action"]"
                           asp-all-route-data="routeValues">
                            1
                        </a>
                    </li>

                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                // Numbered pages
                for (var i = startPage; i <= endPage; i++)
                {
                    routeValues["pageNumber"] = i.ToString();
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="@ViewContext.RouteData.Values["action"]"
                           asp-all-route-data="routeValues">
                            @i
                        </a>
                    </li>
                }

                // Show last page if not in range
                if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    routeValues["pageNumber"] = Model.TotalPages.ToString();
                    <li class="page-item @(Model.PageIndex == Model.TotalPages ? "active" : "")">
                        <a class="page-link"
                           asp-action="@ViewContext.RouteData.Values["action"]"
                           asp-all-route-data="routeValues">
                            @Model.TotalPages
                        </a>
                    </li>
                }
            }

            <!-- Next Page -->
            @if (Model.HasNextPage)
            {
                routeValues["pageNumber"] = (Model.PageIndex + 1).ToString();
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-all-route-data="routeValues">
                    &raquo;
                </a>
            </li>

            <!-- Last Page -->
            @{
                routeValues["pageNumber"] = Model.TotalPages.ToString();
            }
            <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-all-route-data="routeValues">
                    &raquo;&raquo;
                </a>
            </li>
        </ul>
    </nav>
}
