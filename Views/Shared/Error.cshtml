@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_AdminLayout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h1 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Model.StatusCode - @Model.StatusDescription
                    </h1>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h4 class="alert-heading">@Model.Message</h4>
                        @if (Model.ShowRequestId)
                        {
                            <p class="mb-0">
                                <small>Request ID: <code>@Model.RequestId</code></small>
                            </p>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a href="https://portal.pwce.edu.gh/" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Return Home
                        </a>
                        <a href="mailto:pwceshine@yahoo.com" class="btn btn-outline-secondary">
                            <i class="fas fa-envelope me-2"></i>Contact Support
                        </a>
                        @if (Model.StatusCode == 401 || Model.StatusCode == 403)
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn btn-success">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
