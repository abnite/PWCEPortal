@model PWCEPortal.ViewModel.CourseLecturer.DepartmentViewModel
@{
    ViewBag.Title = "Edit Department";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Department</h1>
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-warning"><h5 class="mb-0">Edit Department</h5></div>
        <div class="card-body">
            <form asp-action="EditDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="DepartmentName" class="form-label"></label>
                    <input asp-for="DepartmentName" class="form-control" />
                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Departments" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>
