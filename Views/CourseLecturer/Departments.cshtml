@model IEnumerable<PWCEPortal.Models.Academic.Department>
@{
    ViewBag.Title = "Departments";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Departments</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item active">Departments</li>
            </ol>
        </nav>
    </div>

    <div class="mb-3 text-end">
        @if (User.HasClaim("Permission", "Permissions.CourseLecturer.Assign"))
        {
            <a asp-action="CreateDepartment" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Department</a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="table1" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Department Name</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td><strong>@d.DepartmentName</strong></td>
                                <td class="text-muted">@d.Description</td>
                                <td class="text-center">
                                    @if (User.HasClaim("Permission", "Permissions.CourseLecturer.Assign"))
                                    {
                                        <a asp-action="EditDepartment" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    @if (User.HasClaim("Permission", "Permissions.CourseLecturer.Remove"))
                                    {
                                        <form asp-action="DeleteDepartment" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete department?')">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
