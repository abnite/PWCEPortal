@model PWCEPortal.ViewModel.CourseLecturer.AssignLecturerViewModel
@{
    ViewBag.Title = "Assign Lecturer to Course";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">Assign Lecturer to Course</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","AdminDashboard")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index","CourseLecturer")">Assignments</a></li>
                <li class="breadcrumb-item active">Assign</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-link me-2"></i>New Assignment</h5>
        </div>
        <div class="card-body">
            <form asp-action="Assign" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="LecturerId" class="form-select select2" required>
                                <option value="">-- Select Lecturer --</option>
                                @foreach (var l in Model.Lecturers)
                                {
                                    <option value="@l.Id">@l.User?.LastName @l.User?.FirstName (@l.StaffId)</option>
                                }
                            </select>
                            <label asp-for="LecturerId">Lecturer</label>
                            <span asp-validation-for="LecturerId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="CourseId" class="form-select select2" required>
                                <option value="">-- Select Course --</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">[@c.CourseCode] @c.CourseName (L-@c.Level S-@c.Semester)</option>
                                }
                            </select>
                            <label asp-for="CourseId">Course</label>
                            <span asp-validation-for="CourseId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="AcademicSemesterId" class="form-select" required>
                                <option value="">-- Select Semester --</option>
                                @foreach (var s in Model.Semesters)
                                {
                                    <option value="@s.Id">@s.AcademicYear?.Year – @s.SemesterName</option>
                                }
                            </select>
                            <label asp-for="AcademicSemesterId">Semester</label>
                            <span asp-validation-for="AcademicSemesterId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times me-1"></i>Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-link me-1"></i>Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>
